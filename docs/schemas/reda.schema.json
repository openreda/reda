{
  "$defs": {
    "BomGroup": {
      "description": "Sources shared by Components on a grouped BOM row.",
      "oneOf": [
        {
          "enum": [
            "part",
            "footprint",
            "value"
          ],
          "type": "string"
        },
        {
          "const": "fields",
          "description": "All Component value fields, including manufacturer and supplier numbers.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        }
      ]
    },
    "BomLayout": {
      "enum": [
        "grouped",
        "flat"
      ],
      "type": "string"
    },
    "BomSettings": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "type": "array"
        },
        "designator_separator": {
          "type": "string"
        },
        "group_by": {
          "items": {
            "$ref": "#/$defs/BomGroup"
          },
          "type": "array"
        },
        "layout": {
          "$ref": "#/$defs/BomLayout"
        },
        "line_numbers": {
          "$ref": "#/$defs/LineNumbers"
        },
        "list_unplaced": {
          "type": "boolean"
        },
        "mount_values": {
          "$ref": "#/$defs/MountValues"
        },
        "not_fitted": {
          "$ref": "#/$defs/NotFittedBom"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sort": {
          "items": {
            "$ref": "#/$defs/ColumnSource"
          },
          "type": "array"
        }
      },
      "required": [
        "columns",
        "layout",
        "group_by",
        "sort",
        "line_numbers",
        "designator_separator",
        "not_fitted",
        "required_fields",
        "list_unplaced",
        "mount_values"
      ],
      "type": "object"
    },
    "BottomPosition": {
      "enum": [
        "top_view",
        "negate_x",
        "negate_y"
      ],
      "type": "string"
    },
    "BottomRotation": {
      "enum": [
        "stored",
        "plus_180",
        "negate"
      ],
      "type": "string"
    },
    "Column": {
      "additionalProperties": false,
      "description": "One column of a BOM or CPL file.",
      "properties": {
        "header": {
          "description": "The column header, such as \"LCSC Part #\".",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ColumnSource"
        }
      },
      "required": [
        "header",
        "source"
      ],
      "type": "object"
    },
    "ColumnSource": {
      "description": "Where a BOM or CPL column takes its values from.",
      "oneOf": [
        {
          "const": "line",
          "description": "The row's number, from 1.",
          "type": "string"
        },
        {
          "const": "designator",
          "description": "The Designators of the row, in natural order (CPL: the one Designator).",
          "type": "string"
        },
        {
          "const": "quantity",
          "description": "How many Components the BOM row groups.",
          "type": "string"
        },
        {
          "const": "value",
          "description": "The Component's value, such as `10k`.",
          "type": "string"
        },
        {
          "const": "footprint",
          "description": "The chosen Footprint's name.",
          "type": "string"
        },
        {
          "const": "mount",
          "description": "`SMT` or `THT`.",
          "type": "string"
        },
        {
          "const": "centre_x",
          "description": "Footprint copper-Pad bounding box centre, X, from the output origin.",
          "type": "string"
        },
        {
          "const": "centre_y",
          "description": "Footprint copper-Pad bounding box centre, Y.",
          "type": "string"
        },
        {
          "const": "origin_x",
          "description": "Footprint origin, X.",
          "type": "string"
        },
        {
          "const": "origin_y",
          "description": "Footprint origin, Y.",
          "type": "string"
        },
        {
          "const": "pad1_x",
          "description": "Pad 1, X.",
          "type": "string"
        },
        {
          "const": "pad1_y",
          "description": "Pad 1, Y.",
          "type": "string"
        },
        {
          "const": "fitted",
          "description": "Whether the Component is fitted.",
          "type": "string"
        },
        {
          "const": "side",
          "description": "`Top` or `Bottom`, or the spellings from `side_values`.",
          "type": "string"
        },
        {
          "const": "rotation",
          "description": "The Footprint's rotation in degrees, counter-clockwise.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The Component field with this name, such as `LCSC` or `MPN`.",
          "properties": {
            "field": {
              "type": "string"
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        }
      ]
    },
    "CplSettings": {
      "additionalProperties": false,
      "properties": {
        "bottom_position": {
          "$ref": "#/$defs/BottomPosition"
        },
        "bottom_rotation": {
          "$ref": "#/$defs/BottomRotation"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "type": "array"
        },
        "exclude_through_hole": {
          "type": "boolean"
        },
        "side_values": {
          "$ref": "#/$defs/SideValues"
        },
        "unit_suffix": {
          "type": "boolean"
        },
        "units": {
          "$ref": "#/$defs/CplUnits"
        }
      },
      "required": [
        "columns",
        "side_values",
        "units",
        "unit_suffix",
        "bottom_rotation",
        "bottom_position",
        "exclude_through_hole"
      ],
      "type": "object"
    },
    "CplUnits": {
      "enum": [
        "mm",
        "mil",
        "in"
      ],
      "type": "string"
    },
    "CrossReferenceStyles": {
      "additionalProperties": false,
      "description": "How a Port cross-reference names its partners' places: by sheet, then by location on\nthat sheet.",
      "properties": {
        "location": {
          "$ref": "#/$defs/LocationStyle",
          "default": "zone",
          "description": "Location Style: `zone` by default."
        },
        "sheet": {
          "$ref": "#/$defs/SheetStyle",
          "default": "number",
          "description": "Sheet Style: `number` by default."
        }
      },
      "type": "object"
    },
    "DocumentRow": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "The Document's file name, relative to the Project folder; its stem is the\nDocument's name and its extension its kind.",
          "type": "string"
        },
        "title": {
          "description": "The Document's title, such as \"Sheet 1\".",
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "path",
        "title"
      ],
      "type": "object"
    },
    "ErcSeverities": {
      "additionalProperties": false,
      "description": "The severity of every ERC check, stored in the Project. A check left out has its\ndefault.",
      "properties": {
        "dangling_wire": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "A Wire end that touches nothing."
        },
        "duplicate_designator": {
          "$ref": "#/$defs/Severity",
          "default": "error",
          "description": "Several Components with the same Designator."
        },
        "duplicate_nets": {
          "$ref": "#/$defs/Severity",
          "default": "error",
          "description": "Different Nets with the same board name, such as one Net Label on two sheets. It\nblocks Sync."
        },
        "net_names_across_sheets": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "One Net with different names on different sheets."
        },
        "net_names_on_sheet": {
          "$ref": "#/$defs/Severity",
          "default": "error",
          "description": "One Net with different names on one sheet; names differing only in case are one\nname."
        },
        "no_connect_connected": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "A No-Connect Marker on a Pin that is connected."
        },
        "pin_conflict": {
          "$ref": "#/$defs/Severity",
          "default": "error",
          "description": "Drivers fighting on a Net: Output and Power Out Pins together."
        },
        "pin_conflict_mixed": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "Pin types that should not mix on a Net, such as Tri-state and Output."
        },
        "single_pin_net": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "A wired Net with only one Pin."
        },
        "single_sheet_port": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "A Port whose name no other sheet has."
        },
        "unattached_label": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "A Net Label or Port attached to nothing."
        },
        "unconnected_input": {
          "$ref": "#/$defs/Severity",
          "default": "error",
          "description": "An Input or Power In Pin connected to nothing."
        },
        "unconnected_pin": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "A Pin of another type connected to nothing. Not Connected Pins and Pins with a\nNo-Connect Marker are exempt."
        },
        "undriven_power": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "A Net with Power In Pins and no Power Out Pin or Power Port."
        },
        "unit_data_mismatch": {
          "$ref": "#/$defs/Severity",
          "default": "error",
          "description": "Units of one Component whose Component data differ."
        },
        "unplaced_units": {
          "$ref": "#/$defs/Severity",
          "default": "warning",
          "description": "Units of a placed multi-unit Component left unplaced."
        }
      },
      "type": "object"
    },
    "FabRules": {
      "additionalProperties": false,
      "description": "A Fab Preset's design rules: flat limits with no scope, which a job compares the board\nwith, and the preferred values a new board's routing starts from.",
      "properties": {
        "annular_ring": {
          "description": "Minimum annular ring of Vias and plated Pads.",
          "format": "int64",
          "type": "integer"
        },
        "clearance": {
          "description": "Minimum clearance between copper of different Nets.",
          "format": "int64",
          "type": "integer"
        },
        "edge_clearance": {
          "description": "Minimum clearance from copper to the Board Outline and Board Cutouts.",
          "format": "int64",
          "type": "integer"
        },
        "hole_max": {
          "description": "Maximum Pad, Free Pad and non-plated hole.",
          "format": "int64",
          "type": "integer"
        },
        "hole_min": {
          "description": "Minimum Pad, Free Pad and non-plated hole.",
          "format": "int64",
          "type": "integer"
        },
        "hole_to_hole": {
          "description": "Minimum spacing between hole edges.",
          "format": "int64",
          "type": "integer"
        },
        "preferred": {
          "$ref": "#/$defs/PreferredSeeds",
          "description": "The preferred sizes a new board is seeded with. They are never compared with the\nboard."
        },
        "track_width": {
          "description": "Minimum Track width.",
          "format": "int64",
          "type": "integer"
        },
        "via_diameter": {
          "description": "Minimum Via diameter.",
          "format": "int64",
          "type": "integer"
        },
        "via_hole": {
          "description": "Minimum Via hole.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "clearance",
        "track_width",
        "via_diameter",
        "via_hole",
        "hole_min",
        "hole_max",
        "annular_ring",
        "hole_to_hole",
        "edge_clearance",
        "preferred"
      ],
      "type": "object"
    },
    "FileNaming": {
      "description": "How the Gerber and drill files of a job are named.",
      "oneOf": [
        {
          "const": "classic",
          "description": "Classic extensions: `.gtl`, `.gbl`, `.gts`, … and `.gm1` for the Profile.",
          "type": "string"
        },
        {
          "const": "descriptive",
          "description": "The project and Layer name, ending in `.gbr`.",
          "type": "string"
        }
      ]
    },
    "FileOrigin": {
      "enum": [
        "absolute",
        "relative"
      ],
      "type": "string"
    },
    "GerberSettings": {
      "additionalProperties": false,
      "description": "The Gerber and drill switches of a Fab Preset.",
      "properties": {
        "file_names": {
          "description": "Layer name to output file name; portable between boards and Projects.",
          "items": {
            "$ref": "#/$defs/LayerFileName"
          },
          "type": "array"
        },
        "file_origin": {
          "$ref": "#/$defs/FileOrigin",
          "description": "Shared by Gerber, drill and CPL."
        },
        "merge_drill": {
          "type": "boolean"
        },
        "naming": {
          "$ref": "#/$defs/FileNaming",
          "description": "How the files are named."
        },
        "outline_on_every_plot": {
          "type": "boolean"
        },
        "slot_command": {
          "$ref": "#/$defs/SlotCommand"
        },
        "x2_attributes": {
          "description": "Write Gerber X2 attributes (`.FileFunction` and friends); off writes plain X1.",
          "type": "boolean"
        }
      },
      "required": [
        "x2_attributes",
        "naming",
        "file_origin",
        "slot_command",
        "merge_drill",
        "outline_on_every_plot",
        "file_names"
      ],
      "type": "object"
    },
    "LayerFileName": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "layer",
        "name"
      ],
      "type": "object"
    },
    "LineNumbers": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "step": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "start",
        "step"
      ],
      "type": "object"
    },
    "LocationStyle": {
      "description": "How a cross-reference names where on its sheet a partner is.",
      "oneOf": [
        {
          "const": "none",
          "description": "Not at all.",
          "type": "string"
        },
        {
          "const": "zone",
          "description": "By its Border Zone, such as `B3`; nothing on a sheet with Border Zones off.",
          "type": "string"
        },
        {
          "const": "xy",
          "description": "By its X,Y position on the sheet, in millimetres.",
          "type": "string"
        }
      ]
    },
    "MountValues": {
      "additionalProperties": false,
      "properties": {
        "smt": {
          "type": "string"
        },
        "tht": {
          "type": "string"
        }
      },
      "required": [
        "smt",
        "tht"
      ],
      "type": "object"
    },
    "NotFittedBom": {
      "enum": [
        "omit",
        "list"
      ],
      "type": "string"
    },
    "NotFittedPaste": {
      "description": "Whether this build retains Not Fitted Components' paste openings.",
      "enum": [
        "keep",
        "remove"
      ],
      "type": "string"
    },
    "OutputJob": {
      "additionalProperties": false,
      "description": "A named recipe for manufacturing files, stored in the Project file.",
      "properties": {
        "destination": {
          "description": "The output folder relative to the Project folder, `/`-separated; left out for\n`outputs/<job name>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "fab_preset": {
          "description": "The Project copy of the Fab Preset it uses.",
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "name_template": {
          "description": "The zip and assembly files' stem, resolved with the shared text resolver.",
          "type": "string"
        },
        "not_fitted_paste": {
          "$ref": "#/$defs/NotFittedPaste"
        },
        "outputs": {
          "$ref": "#/$defs/Outputs"
        },
        "pcb": {
          "description": "The PCB Document it plots. A job whose PCB Document is gone is broken until it is\npointed at another.",
          "format": "uuid",
          "type": "string"
        },
        "schematic_pdf_colour": {
          "$ref": "#/$defs/PdfColour"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "name",
        "pcb",
        "fab_preset",
        "outputs",
        "name_template",
        "not_fitted_paste",
        "schematic_pdf_colour"
      ],
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "description": "Which files an Output Job writes.",
      "properties": {
        "bom": {
          "description": "The CSV bill of materials.",
          "type": "boolean"
        },
        "cpl": {
          "description": "The CSV pick-and-place file.",
          "type": "boolean"
        },
        "drill": {
          "description": "Excellon drill files, plated and non-plated.",
          "type": "boolean"
        },
        "drill_report": {
          "type": "boolean"
        },
        "fab_notes": {
          "type": "boolean"
        },
        "gerber": {
          "description": "Gerber files for copper, mask, paste, silkscreen and the Board Outline.",
          "type": "boolean"
        },
        "gerber_job": {
          "type": "boolean"
        },
        "reports": {
          "type": "boolean"
        },
        "schematic_pdf": {
          "type": "boolean"
        }
      },
      "required": [
        "gerber",
        "drill",
        "bom",
        "cpl",
        "fab_notes",
        "drill_report",
        "gerber_job",
        "reports",
        "schematic_pdf"
      ],
      "type": "object"
    },
    "PdfColour": {
      "description": "The schematic PDF's paper colour mode.",
      "enum": [
        "colour",
        "mono"
      ],
      "type": "string"
    },
    "PreferredSeeds": {
      "additionalProperties": false,
      "description": "The preferred Track and Via sizes a Fab Preset seeds a new board with.",
      "properties": {
        "track_width": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "via_diameter": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "via_hole": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "track_width",
        "via_diameter",
        "via_hole"
      ],
      "type": "object"
    },
    "ProjectFabPreset": {
      "additionalProperties": false,
      "description": "The Project's own copy of a Fab Preset, so outputs come out the same on any machine.\nIts fields are a [`FabPreset`]'s, after the UUID.",
      "properties": {
        "bom": {
          "$ref": "#/$defs/BomSettings"
        },
        "cpl": {
          "$ref": "#/$defs/CplSettings"
        },
        "gerber": {
          "$ref": "#/$defs/GerberSettings"
        },
        "name": {
          "description": "The name of the preset it was copied from.",
          "type": "string"
        },
        "rules": {
          "$ref": "#/$defs/FabRules"
        },
        "stackup": {
          "$ref": "#/$defs/StackupSeeds"
        },
        "stackup_suggestions": {
          "$ref": "#/$defs/StackupSuggestions"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "zip_assembly": {
          "type": "boolean"
        }
      },
      "required": [
        "uuid",
        "name",
        "rules",
        "gerber",
        "stackup_suggestions",
        "zip_assembly",
        "bom",
        "cpl"
      ],
      "type": "object"
    },
    "ProjectProperties": {
      "additionalProperties": false,
      "description": "The Project properties: fixed free-text fields that fill each sheet's title block. The\nboard thickness and copper are the PCB Document's [`crate::Stackup`].",
      "properties": {
        "author": {
          "default": "",
          "type": "string"
        },
        "company": {
          "default": "",
          "type": "string"
        },
        "date": {
          "default": "",
          "description": "Free text, such as `2026-11-01`.",
          "type": "string"
        },
        "revision": {
          "default": "",
          "type": "string"
        },
        "title": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ProjectRow": {
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "required": [
        "uuid"
      ],
      "type": "object"
    },
    "SchematicOptions": {
      "additionalProperties": false,
      "description": "The Project's schematic options: how Nets are named and Ports cross-referenced.",
      "properties": {
        "allow_ports_to_name_nets": {
          "default": true,
          "description": "Allow Ports to Name Nets. Off, a Port still joins its Net across sheets but never\nnames it.",
          "type": "boolean"
        },
        "append_sheet_numbers": {
          "default": false,
          "description": "Append Sheet Numbers to Local Nets: every Local Net named by a Net Label gets the\nboard name `<name>_<n>`, `n` being its sheet's number. Sheets keep showing the plain\nname.",
          "type": "boolean"
        },
        "cross_reference_styles": {
          "$ref": "#/$defs/CrossReferenceStyles",
          "default": {
            "location": "zone",
            "sheet": "number"
          },
          "description": "The Project's cross-reference styles, unless it follows the Preferences."
        },
        "cross_references": {
          "default": false,
          "description": "Automatic Cross References: each Port shows where its partners are, such as\n`[2:B3]`. Off by default, so a Project opts in.",
          "type": "boolean"
        },
        "cross_references_follow_preferences": {
          "default": false,
          "description": "Follow Cross References settings in Preferences: the styles come from the\nPreferences instead of [`SchematicOptions::cross_reference_styles`]. Off by default.",
          "type": "boolean"
        },
        "power_port_names_priority": {
          "default": false,
          "description": "Power Port Names Take Priority: a Power Port's name beats a Net Label's, giving\nPower Port > Net Label > Port > auto-name. Off by default (Net Label > Power Port >\nPort > auto-name).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Severity": {
      "description": "How a check's Violations are reported.",
      "enum": [
        "error",
        "warning",
        "off"
      ],
      "type": "string"
    },
    "SheetStyle": {
      "description": "How a cross-reference names a partner's sheet.",
      "oneOf": [
        {
          "const": "none",
          "description": "Not at all.",
          "type": "string"
        },
        {
          "const": "name",
          "description": "By the sheet's title, as in the Projects panel.",
          "type": "string"
        },
        {
          "const": "number",
          "description": "By its number in the Projects panel, from 1.",
          "type": "string"
        }
      ]
    },
    "SideValues": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "type": "string"
        },
        "top": {
          "type": "string"
        }
      },
      "required": [
        "top",
        "bottom"
      ],
      "type": "object"
    },
    "SlotCommand": {
      "enum": [
        "route",
        "g85"
      ],
      "type": "string"
    },
    "StackupSeeds": {
      "additionalProperties": false,
      "description": "A new board's Stackup values, from its Fab Preset. A value left out uses the fallback:\n[`DEFAULT_BOARD_THICKNESS`] and [`DEFAULT_COPPER`].",
      "properties": {
        "copper": {
          "description": "The copper thickness of every copper Layer.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "thickness": {
          "description": "The finished board thickness.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "StackupSuggestions": {
      "additionalProperties": false,
      "description": "Suggestions never validate the board or seed its finish or colours.",
      "properties": {
        "copper": {
          "items": {
            "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "finish": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mask_color": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "silk_color": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "thickness": {
          "items": {
            "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "thickness",
        "copper",
        "finish",
        "mask_color",
        "silk_color"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A REDA Project file (`.reda`). The Project's name is the file stem.",
  "properties": {
    "documents": {
      "description": "The Project's Documents, in Project order (sheet numbering, PDF output).",
      "items": {
        "$ref": "#/$defs/DocumentRow"
      },
      "type": "array"
    },
    "erc": {
      "$ref": "#/$defs/ErcSeverities",
      "default": {
        "dangling_wire": "warning",
        "duplicate_designator": "error",
        "duplicate_nets": "error",
        "net_names_across_sheets": "warning",
        "net_names_on_sheet": "error",
        "no_connect_connected": "warning",
        "pin_conflict": "error",
        "pin_conflict_mixed": "warning",
        "single_pin_net": "warning",
        "single_sheet_port": "warning",
        "unattached_label": "warning",
        "unconnected_input": "error",
        "unconnected_pin": "warning",
        "undriven_power": "warning",
        "unit_data_mismatch": "error",
        "unplaced_units": "warning"
      },
      "description": "The ERC severities, `error`, `warning` or `off` per check. Written only when any\ndiffers from its default; a check left out has its default."
    },
    "fab_presets": {
      "default": [],
      "description": "The Project's copies of the Fab Presets its Output Jobs use, in the same shape as a\n`.redafab` file plus a UUID.",
      "items": {
        "$ref": "#/$defs/ProjectFabPreset"
      },
      "type": "array"
    },
    "format": {
      "const": 1,
      "description": "The file-format version. REDA writes only the current one.",
      "type": "integer"
    },
    "libraries": {
      "default": [],
      "description": "The Project Libraries: folders relative to the Project folder, `/`-separated.\nWritten only when there are any.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "output_jobs": {
      "default": [],
      "description": "The Output Jobs.",
      "items": {
        "$ref": "#/$defs/OutputJob"
      },
      "type": "array"
    },
    "project": {
      "$ref": "#/$defs/ProjectRow",
      "description": "Project-wide properties."
    },
    "properties": {
      "$ref": "#/$defs/ProjectProperties",
      "default": {
        "author": "",
        "company": "",
        "date": "",
        "revision": "",
        "title": ""
      },
      "description": "The Project properties that fill the sheets' title blocks. Written only when any\nis set."
    },
    "schematic": {
      "$ref": "#/$defs/SchematicOptions",
      "default": {
        "allow_ports_to_name_nets": true,
        "append_sheet_numbers": false,
        "cross_reference_styles": {
          "location": "zone",
          "sheet": "number"
        },
        "cross_references": false,
        "cross_references_follow_preferences": false,
        "power_port_names_priority": false
      },
      "description": "The schematic options: how Nets are named. Written only when any differs from its\ndefault; an option left out has its default."
    }
  },
  "required": [
    "format",
    "project",
    "documents"
  ],
  "title": "REDA Project file",
  "type": "object"
}
