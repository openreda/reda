{
  "$defs": {
    "FootprintGraphic": {
      "additionalProperties": false,
      "description": "One shape a Footprint draws on a non-copper Layer.",
      "properties": {
        "fill": {
          "description": "Whether a closed shape is filled.",
          "type": "boolean"
        },
        "layer": {
          "$ref": "#/$defs/FootprintLayer"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "width": {
          "description": "The stroke width.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uuid",
        "layer",
        "shape",
        "width"
      ],
      "type": "object"
    },
    "FootprintLayer": {
      "description": "The Layers a Footprint draws on besides copper.",
      "enum": [
        "silkscreen_top",
        "silkscreen_bottom",
        "courtyard_top",
        "courtyard_bottom",
        "assembly_top",
        "assembly_bottom"
      ],
      "type": "string"
    },
    "FootprintRow": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "name"
      ],
      "type": "object"
    },
    "FootprintText": {
      "additionalProperties": false,
      "description": "The placement of a Footprint's Designator or value text.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point",
          "description": "The text centre, relative to the Footprint origin."
        },
        "layer": {
          "$ref": "#/$defs/FootprintLayer"
        },
        "rotation": {
          "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "size": {
          "description": "The text height.",
          "format": "int64",
          "type": "integer"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "at",
        "rotation",
        "size",
        "layer"
      ],
      "type": "object"
    },
    "FootprintTexts": {
      "additionalProperties": false,
      "properties": {
        "designator": {
          "$ref": "#/$defs/FootprintText"
        },
        "value": {
          "$ref": "#/$defs/FootprintText"
        }
      },
      "required": [
        "designator",
        "value"
      ],
      "type": "object"
    },
    "Hole": {
      "additionalProperties": false,
      "description": "A drilled hole: round when `width == height`, otherwise a slot along the longer side.",
      "properties": {
        "height": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "width": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "Pad": {
      "additionalProperties": false,
      "description": "A copper area, with or without a hole, of a Footprint.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point",
          "description": "The Pad centre, relative to the Footprint origin."
        },
        "corner_radius": {
          "description": "The corner radius of a rounded-rectangle Pad.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "hole": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hole"
            },
            {
              "type": "null"
            }
          ],
          "description": "A round hole when width equals height, otherwise a slot. SMD Pads have none."
        },
        "kind": {
          "$ref": "#/$defs/PadKind"
        },
        "mask_margin": {
          "description": "Overrides the board's solder-mask margin for this Pad.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "number": {
          "type": "string"
        },
        "paste_margin": {
          "description": "Overrides the board's solder-paste margin for this Pad.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "rotation": {
          "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "shape": {
          "$ref": "#/$defs/PadShape"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "width": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uuid",
        "number",
        "kind",
        "shape",
        "at",
        "rotation",
        "width",
        "height"
      ],
      "type": "object"
    },
    "PadKind": {
      "enum": [
        "smd",
        "plated_through_hole",
        "non_plated"
      ],
      "type": "string"
    },
    "PadShape": {
      "enum": [
        "circle",
        "rect",
        "rounded_rect",
        "oval"
      ],
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A position on a Schematic Sheet or the PCB Document, which share one coordinate type.",
      "properties": {
        "x": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Shape": {
      "description": "A drawn shape. Lines, arcs and outlines are stroked with the graphic's width.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "end": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "line",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An axis-aligned rectangle between two opposite corners.",
          "properties": {
            "end": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "rect",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The arc from `start` around `center`, sweeping `sweep` counter-clockwise (negative\nis clockwise).",
          "properties": {
            "center": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "arc",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Point"
            },
            "sweep": {
              "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "center",
            "start",
            "sweep"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "center": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "circle",
              "type": "string"
            },
            "radius": {
              "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "center",
            "radius"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A closed polygon through its corners.",
          "properties": {
            "kind": {
              "const": "polygon",
              "type": "string"
            },
            "points": {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "points"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "$ref": "#/$defs/Point",
              "description": "The text's anchor."
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "rotation": {
              "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            },
            "size": {
              "description": "The text height.",
              "format": "int64",
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "text",
            "size",
            "rotation"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A REDA Footprint file (`.redafp`).",
  "properties": {
    "footprint": {
      "$ref": "#/$defs/FootprintRow"
    },
    "format": {
      "const": 1,
      "description": "The file-format version. REDA writes only the current one.",
      "type": "integer"
    },
    "graphics": {
      "default": [],
      "description": "The Silkscreen, Courtyard and Assembly drawing, sorted by UUID.",
      "items": {
        "$ref": "#/$defs/FootprintGraphic"
      },
      "type": "array"
    },
    "pads": {
      "description": "The Pads, sorted by UUID. Pads that share a number belong to one Pin.",
      "items": {
        "$ref": "#/$defs/Pad"
      },
      "type": "array"
    },
    "text": {
      "$ref": "#/$defs/FootprintTexts",
      "default": {
        "designator": {
          "at": {
            "x": 0,
            "y": 0
          },
          "layer": "silkscreen_top",
          "rotation": 0,
          "size": 1000000
        },
        "value": {
          "at": {
            "x": 0,
            "y": 0
          },
          "layer": "assembly_top",
          "rotation": 0,
          "size": 1000000
        }
      },
      "description": "Where the Designator and value text go."
    }
  },
  "required": [
    "format",
    "footprint",
    "pads"
  ],
  "title": "REDA Footprint file",
  "type": "object"
}
