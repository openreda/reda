{
  "$defs": {
    "FootprintGenerator": {
      "additionalProperties": false,
      "description": "The command and params that generated a Footprint, every value resolved, so running\nthem again gives the same Footprint unless the generator itself changed.",
      "properties": {
        "command": {
          "description": "The generator Command, such as `library.footprint.generate.chip`.",
          "type": "string"
        },
        "params": true
      },
      "required": [
        "command",
        "params"
      ],
      "type": "object"
    },
    "FootprintGraphic": {
      "additionalProperties": false,
      "description": "One shape a Footprint draws on a non-copper Layer.",
      "properties": {
        "fill": {
          "description": "Whether a closed shape is filled.",
          "type": "boolean"
        },
        "layer": {
          "$ref": "#/$defs/FootprintLayer"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "width": {
          "description": "The stroke width.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uuid",
        "layer",
        "shape",
        "width"
      ],
      "type": "object"
    },
    "FootprintLayer": {
      "description": "The Layers a Footprint draws on besides copper.",
      "enum": [
        "silkscreen_top",
        "silkscreen_bottom",
        "courtyard_top",
        "courtyard_bottom",
        "assembly_top",
        "assembly_bottom"
      ],
      "type": "string"
    },
    "FootprintRow": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "height": {
          "description": "The part's greatest height above the board, when known.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "name"
      ],
      "type": "object"
    },
    "FootprintText": {
      "additionalProperties": false,
      "description": "One field text of a Footprint, on a Silkscreen or Assembly Layer.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point",
          "description": "The text centre, relative to the Footprint origin."
        },
        "field": {
          "description": "The field it shows: `Designator`, `Value` or any field name. A field the Component\ndoes not have draws nothing.",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/FootprintLayer"
        },
        "rotation": {
          "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "style": {
          "$ref": "#/$defs/TextStyle"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "uuid",
        "field",
        "at",
        "rotation",
        "style",
        "layer"
      ],
      "type": "object"
    },
    "Hole": {
      "additionalProperties": false,
      "description": "A drilled hole: round when `width == height`, otherwise a slot along the longer side.",
      "properties": {
        "height": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "width": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "Pad": {
      "additionalProperties": false,
      "description": "A copper area, with or without a hole, of a Footprint.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point",
          "description": "The Pad centre, relative to the Footprint origin."
        },
        "corner_radius": {
          "description": "The corner radius of a rounded-rectangle Pad.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "hole": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hole"
            },
            {
              "type": "null"
            }
          ],
          "description": "A round hole when width equals height, otherwise a slot. SMD Pads have none."
        },
        "kind": {
          "$ref": "#/$defs/PadKind"
        },
        "mask_margin": {
          "description": "Overrides the board's solder-mask margin for this Pad.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "number": {
          "type": "string"
        },
        "paste_margin": {
          "description": "Overrides the board's solder-paste margin for this Pad.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "rotation": {
          "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "shape": {
          "$ref": "#/$defs/PadShape"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "width": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uuid",
        "number",
        "kind",
        "shape",
        "at",
        "rotation",
        "width",
        "height"
      ],
      "type": "object"
    },
    "PadKind": {
      "enum": [
        "smd",
        "plated_through_hole",
        "non_plated"
      ],
      "type": "string"
    },
    "PadShape": {
      "enum": [
        "circle",
        "rect",
        "rounded_rect",
        "oval"
      ],
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A position on a Schematic Sheet or the PCB Document, which share one coordinate type.",
      "properties": {
        "x": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where an imported Library element came from, kept with the element so its terms travel\nwith it: vendor parts stay under the vendor's terms after import.",
      "properties": {
        "copyright": {
          "description": "Copyright lines found in the imported files, kept verbatim.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "service": {
          "description": "The service the files came from, such as `SnapMagic`, or `Unknown`.",
          "type": "string"
        },
        "terms_url": {
          "description": "The service's terms of use, when known.",
          "type": "string"
        }
      },
      "required": [
        "service"
      ],
      "type": "object"
    },
    "Shape": {
      "description": "A drawn shape. Lines, arcs and outlines are stroked with the graphic's width.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "end": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "line",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An axis-aligned rectangle between two opposite corners.",
          "properties": {
            "end": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "rect",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The arc from `start` around `center`, sweeping `sweep` counter-clockwise (negative\nis clockwise).",
          "properties": {
            "center": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "arc",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Point"
            },
            "sweep": {
              "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "center",
            "start",
            "sweep"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "center": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "circle",
              "type": "string"
            },
            "radius": {
              "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "center",
            "radius"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A closed polygon through its corners.",
          "properties": {
            "kind": {
              "const": "polygon",
              "type": "string"
            },
            "points": {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "points"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "$ref": "#/$defs/Point",
              "description": "The text's anchor."
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "rotation": {
              "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            },
            "size": {
              "description": "The text height.",
              "format": "int64",
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "text",
            "size",
            "rotation"
          ],
          "type": "object"
        }
      ]
    },
    "TextStyle": {
      "additionalProperties": false,
      "description": "How a Footprint text is drawn.",
      "properties": {
        "font": {
          "description": "The font family, such as `Hershey Roman Simplex` or `Noto Sans`. A family missing\non this machine draws as Noto Sans.",
          "type": "string"
        },
        "height": {
          "description": "The capital height.",
          "format": "int64",
          "type": "integer"
        },
        "thickness": {
          "description": "The pen width of stroke-font text; outline fonts are filled and ignore it.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "font",
        "height",
        "thickness"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A REDA Footprint file (`.redafp`).",
  "properties": {
    "footprint": {
      "$ref": "#/$defs/FootprintRow"
    },
    "format": {
      "const": 1,
      "description": "The file-format version. REDA writes only the current one.",
      "type": "integer"
    },
    "generator": {
      "anyOf": [
        {
          "$ref": "#/$defs/FootprintGenerator"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The generator Command and resolved params that made the Footprint. Only the\nLibrary file holds it: Document copies and their hashes leave it out."
    },
    "graphics": {
      "default": [],
      "description": "The Silkscreen, Courtyard and Assembly drawing, sorted by UUID.",
      "items": {
        "$ref": "#/$defs/FootprintGraphic"
      },
      "type": "array"
    },
    "pads": {
      "description": "The Pads, sorted by UUID. Pads that share a number belong to one Pin.",
      "items": {
        "$ref": "#/$defs/Pad"
      },
      "type": "array"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Where an imported element came from: the service, its terms and any copyright\nlines. Elements made in REDA have none."
    },
    "texts": {
      "default": [],
      "description": "The field texts, such as the Designator and value, sorted by UUID.",
      "items": {
        "$ref": "#/$defs/FootprintText"
      },
      "type": "array"
    }
  },
  "required": [
    "format",
    "footprint",
    "pads"
  ],
  "title": "REDA Footprint file",
  "type": "object"
}
