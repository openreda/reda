{
  "$defs": {
    "BoardCutout": {
      "additionalProperties": false,
      "description": "A closed shape inside the Board Outline where board material is removed.",
      "properties": {
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "vertices": {
          "description": "The contour; the last vertex joins the first.",
          "items": {
            "$ref": "#/$defs/Vertex"
          },
          "type": "array"
        }
      },
      "required": [
        "uuid",
        "vertices"
      ],
      "type": "object"
    },
    "BoardOutline": {
      "additionalProperties": false,
      "description": "The closed shape of the board's physical edge.",
      "properties": {
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "vertices": {
          "description": "The contour, counter-clockwise or not; the last vertex joins the first.",
          "items": {
            "$ref": "#/$defs/Vertex"
          },
          "type": "array"
        }
      },
      "required": [
        "uuid",
        "vertices"
      ],
      "type": "object"
    },
    "BoardRow": {
      "additionalProperties": false,
      "properties": {
        "default_net_class": {
          "description": "The Net Class new Nets get.",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "default_net_class"
      ],
      "type": "object"
    },
    "DrcSeverities": {
      "additionalProperties": false,
      "description": "The severity of every DRC check, stored next to the rules.",
      "properties": {
        "annular_ring": {
          "$ref": "#/$defs/Severity",
          "description": "An annular ring below the minimum."
        },
        "clearance": {
          "$ref": "#/$defs/Severity",
          "description": "Clearance between copper of different Nets."
        },
        "copper_without_net": {
          "$ref": "#/$defs/Severity",
          "description": "Copper with no Net."
        },
        "courtyard_overlap": {
          "$ref": "#/$defs/Severity",
          "description": "Overlapping courtyards."
        },
        "dangling": {
          "$ref": "#/$defs/Severity",
          "description": "Tracks and Vias that end unconnected."
        },
        "edge_clearance": {
          "$ref": "#/$defs/Severity",
          "description": "Copper too close to the Board Outline or a Board Cutout."
        },
        "footprint_outside_board": {
          "$ref": "#/$defs/Severity",
          "description": "A Footprint outside the Board Outline."
        },
        "hole_size": {
          "$ref": "#/$defs/Severity",
          "description": "A Via or Pad hole smaller than the minimum."
        },
        "hole_to_hole": {
          "$ref": "#/$defs/Severity",
          "description": "Holes closer than the minimum spacing."
        },
        "keepout": {
          "$ref": "#/$defs/Severity",
          "description": "An object inside a Keepout that forbids it."
        },
        "out_of_sync": {
          "$ref": "#/$defs/Severity",
          "description": "The PCB out of sync with the schematic."
        },
        "short_circuit": {
          "$ref": "#/$defs/Severity",
          "description": "Different Nets touching."
        },
        "silkscreen_over_pads": {
          "$ref": "#/$defs/Severity",
          "description": "Silkscreen over exposed Pads."
        },
        "track_width": {
          "$ref": "#/$defs/Severity",
          "description": "A Track narrower than the minimum."
        },
        "unrouted": {
          "$ref": "#/$defs/Severity",
          "description": "Connections the Ratsnest still shows."
        }
      },
      "required": [
        "clearance",
        "short_circuit",
        "track_width",
        "hole_size",
        "annular_ring",
        "hole_to_hole",
        "edge_clearance",
        "keepout",
        "footprint_outside_board",
        "unrouted",
        "copper_without_net",
        "dangling",
        "courtyard_overlap",
        "silkscreen_over_pads",
        "out_of_sync"
      ],
      "type": "object"
    },
    "GraphicShape": {
      "description": "The shape of a [`PcbGraphic`].",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A straight line.",
          "properties": {
            "from": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "line",
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A circular arc from `from` to `to`, sweeping `sweep` (counter-clockwise when\npositive).",
          "properties": {
            "from": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "arc",
              "type": "string"
            },
            "sweep": {
              "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            },
            "to": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "from",
            "to",
            "sweep"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An axis-aligned rectangle with opposite corners `from` and `to`, outlined, or\nfilled as well when `filled`.",
          "properties": {
            "filled": {
              "type": "boolean"
            },
            "from": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "rect",
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "from",
            "to"
          ],
          "type": "object"
        }
      ]
    },
    "Layer": {
      "additionalProperties": false,
      "description": "One Layer. Objects name their Layer by UUID, never by position.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LayerKind"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "description": "The board face, for sided Layers; left out for the others."
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "kind"
      ],
      "type": "object"
    },
    "LayerKind": {
      "description": "What a Layer is for. Copper and the sided kinds come with a [`Side`].",
      "enum": [
        "copper",
        "silkscreen",
        "solder_mask",
        "paste",
        "courtyard",
        "assembly",
        "board_outline",
        "mechanical",
        "documentation"
      ],
      "type": "string"
    },
    "LayerSet": {
      "additionalProperties": false,
      "description": "The PCB Document's Layers as one ordered list, top to bottom. A generic list, so more\ncopper Layers need no format change.",
      "properties": {
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "type": "array"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "layers"
      ],
      "type": "object"
    },
    "Net": {
      "additionalProperties": false,
      "description": "A PCB Net: Pads, Tracks, Vias and Zones name it by UUID.",
      "properties": {
        "class": {
          "description": "Its Net Class.",
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "name",
        "class"
      ],
      "type": "object"
    },
    "NetClass": {
      "additionalProperties": false,
      "description": "A named group of Nets that share design rules. A value left out uses the board-wide\nrule.",
      "properties": {
        "clearance": {
          "description": "Clearance to copper of other Nets; where two classes meet, the larger applies.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "track_width": {
          "description": "Track width for routing this class.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "via_diameter": {
          "description": "Via diameter for this class.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "via_hole": {
          "description": "Via hole for this class.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "uuid",
        "name"
      ],
      "type": "object"
    },
    "PcbGraphic": {
      "additionalProperties": false,
      "description": "A line, arc or rectangle drawn on a PCB Layer with a round pen.",
      "properties": {
        "layer": {
          "description": "The Layer it is drawn on.",
          "format": "uuid",
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/GraphicShape"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "width": {
          "description": "The pen width.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uuid",
        "layer",
        "width",
        "shape"
      ],
      "type": "object"
    },
    "PcbRow": {
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "required": [
        "uuid"
      ],
      "type": "object"
    },
    "PcbText": {
      "additionalProperties": false,
      "description": "Free text on a PCB Layer.\n\nThe text starts at `position`, the left end of its first baseline; each further line\n(after a `\\n`) sits one line pitch below. Mirroring flips it about the vertical line\nthrough `position`, then the rotation turns it about the same point.",
      "properties": {
        "font": {
          "description": "The font family, such as `Hershey Roman Simplex`, `Noto Sans` or an installed\nfont. A family missing on this machine draws as Noto Sans.",
          "type": "string"
        },
        "height": {
          "description": "The capital height.",
          "format": "int64",
          "type": "integer"
        },
        "layer": {
          "description": "The Layer it is drawn on.",
          "format": "uuid",
          "type": "string"
        },
        "mirrored": {
          "description": "Drawn mirrored, so it reads from below; only on bottom Layers. Left out when false.",
          "type": "boolean"
        },
        "position": {
          "$ref": "#/$defs/Point",
          "description": "The left end of the first line's baseline."
        },
        "rotation": {
          "description": "Counter-clockwise about `position`; left out when 0.",
          "format": "int64",
          "type": "integer"
        },
        "text": {
          "description": "The text; `\\n` starts a new line.",
          "type": "string"
        },
        "thickness": {
          "description": "The pen width of stroke-font text; outline fonts are filled and ignore it.",
          "format": "int64",
          "type": "integer"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "layer",
        "text",
        "font",
        "position",
        "height",
        "thickness"
      ],
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A position on a Schematic Sheet or the PCB Document, which share one coordinate type.",
      "properties": {
        "x": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Rules": {
      "additionalProperties": false,
      "description": "The board-wide minimum values that DRC checks against.\n\nNet Classes override some of them per Net. Later per-Layer or per-area rules (and a rule\nquery language) are meant to be new object kinds that override these values in a\nscope, so this set stays the board-wide fallback.",
      "properties": {
        "annular_ring": {
          "description": "Minimum annular ring of Vias and plated Pads.",
          "format": "int64",
          "type": "integer"
        },
        "clearance": {
          "description": "Minimum clearance between copper of different Nets.",
          "format": "int64",
          "type": "integer"
        },
        "edge_clearance": {
          "description": "Minimum clearance from copper to the Board Outline and Board Cutouts.",
          "format": "int64",
          "type": "integer"
        },
        "hole_to_hole": {
          "description": "Minimum spacing between hole edges.",
          "format": "int64",
          "type": "integer"
        },
        "track_width": {
          "description": "Minimum Track width.",
          "format": "int64",
          "type": "integer"
        },
        "via_diameter": {
          "description": "Minimum Via diameter.",
          "format": "int64",
          "type": "integer"
        },
        "via_hole": {
          "description": "Minimum Via hole.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "clearance",
        "track_width",
        "via_diameter",
        "via_hole",
        "annular_ring",
        "hole_to_hole",
        "edge_clearance"
      ],
      "type": "object"
    },
    "Severity": {
      "description": "How a check's Violations are reported.",
      "enum": [
        "error",
        "warning",
        "off"
      ],
      "type": "string"
    },
    "Side": {
      "description": "Which face of the board a sided Layer is on.",
      "enum": [
        "top",
        "bottom"
      ],
      "type": "string"
    },
    "Vertex": {
      "additionalProperties": false,
      "description": "One corner of a contour and the edge that leaves it towards the next vertex.",
      "properties": {
        "sweep": {
          "description": "The edge to the next vertex: left out (or 0) for a straight edge, otherwise an arc\nsweeping this angle, counter-clockwise when positive.",
          "format": "int64",
          "type": "integer"
        },
        "x": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A REDA PCB Document file (`.redapcb`).",
  "properties": {
    "board": {
      "$ref": "#/$defs/BoardRow",
      "description": "The board setup's identity and its Default Net Class."
    },
    "board_cutouts": {
      "description": "Holes in the board material.",
      "items": {
        "$ref": "#/$defs/BoardCutout"
      },
      "type": "array"
    },
    "board_outline": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoardOutline"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The board's edge; left out while the board has none."
    },
    "format": {
      "const": 1,
      "description": "The file-format version. REDA writes only the current one.",
      "type": "integer"
    },
    "graphics": {
      "description": "Lines, arcs and rectangles on copper, silkscreen, mechanical and documentation\nLayers.",
      "items": {
        "$ref": "#/$defs/PcbGraphic"
      },
      "type": "array"
    },
    "layers": {
      "$ref": "#/$defs/LayerSet",
      "description": "The Layers, top to bottom. Objects name a Layer by its UUID."
    },
    "net_classes": {
      "description": "The Net Classes, the Default Net Class among them.",
      "items": {
        "$ref": "#/$defs/NetClass"
      },
      "type": "array"
    },
    "nets": {
      "description": "The PCB Nets.",
      "items": {
        "$ref": "#/$defs/Net"
      },
      "type": "array"
    },
    "pcb": {
      "$ref": "#/$defs/PcbRow",
      "description": "The PCB Document's identity; it matches its entry in the Project file."
    },
    "rules": {
      "$ref": "#/$defs/Rules",
      "description": "The board-wide design rules."
    },
    "severities": {
      "$ref": "#/$defs/DrcSeverities",
      "description": "The severity of each DRC check."
    },
    "texts": {
      "description": "Free text on copper, silkscreen, mechanical and documentation Layers.",
      "items": {
        "$ref": "#/$defs/PcbText"
      },
      "type": "array"
    }
  },
  "required": [
    "format",
    "pcb",
    "layers",
    "board",
    "rules",
    "severities",
    "board_cutouts",
    "net_classes",
    "nets",
    "texts",
    "graphics"
  ],
  "title": "REDA PCB Document file",
  "type": "object"
}
