{
  "$defs": {
    "BomGroup": {
      "description": "Sources shared by Components on a grouped BOM row.",
      "oneOf": [
        {
          "enum": [
            "part",
            "footprint",
            "value"
          ],
          "type": "string"
        },
        {
          "const": "fields",
          "description": "All Component value fields, including manufacturer and supplier numbers.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        }
      ]
    },
    "BomLayout": {
      "enum": [
        "grouped",
        "flat"
      ],
      "type": "string"
    },
    "BomSettings": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "type": "array"
        },
        "designator_separator": {
          "type": "string"
        },
        "group_by": {
          "items": {
            "$ref": "#/$defs/BomGroup"
          },
          "type": "array"
        },
        "layout": {
          "$ref": "#/$defs/BomLayout"
        },
        "line_numbers": {
          "$ref": "#/$defs/LineNumbers"
        },
        "list_unplaced": {
          "type": "boolean"
        },
        "mount_values": {
          "$ref": "#/$defs/MountValues"
        },
        "not_fitted": {
          "$ref": "#/$defs/NotFittedBom"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sort": {
          "items": {
            "$ref": "#/$defs/ColumnSource"
          },
          "type": "array"
        }
      },
      "required": [
        "columns",
        "layout",
        "group_by",
        "sort",
        "line_numbers",
        "designator_separator",
        "not_fitted",
        "required_fields",
        "list_unplaced",
        "mount_values"
      ],
      "type": "object"
    },
    "BottomPosition": {
      "enum": [
        "top_view",
        "negate_x",
        "negate_y"
      ],
      "type": "string"
    },
    "BottomRotation": {
      "enum": [
        "stored",
        "plus_180",
        "negate"
      ],
      "type": "string"
    },
    "Column": {
      "additionalProperties": false,
      "description": "One column of a BOM or CPL file.",
      "properties": {
        "header": {
          "description": "The column header, such as \"LCSC Part #\".",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ColumnSource"
        }
      },
      "required": [
        "header",
        "source"
      ],
      "type": "object"
    },
    "ColumnSource": {
      "description": "Where a BOM or CPL column takes its values from.",
      "oneOf": [
        {
          "const": "line",
          "description": "The row's number, from 1.",
          "type": "string"
        },
        {
          "const": "designator",
          "description": "The Designators of the row, in natural order (CPL: the one Designator).",
          "type": "string"
        },
        {
          "const": "quantity",
          "description": "How many Components the BOM row groups.",
          "type": "string"
        },
        {
          "const": "value",
          "description": "The Component's value, such as `10k`.",
          "type": "string"
        },
        {
          "const": "footprint",
          "description": "The chosen Footprint's name.",
          "type": "string"
        },
        {
          "const": "mount",
          "description": "`SMT` or `THT`.",
          "type": "string"
        },
        {
          "const": "centre_x",
          "description": "Footprint copper-Pad bounding box centre, X, from the output origin.",
          "type": "string"
        },
        {
          "const": "centre_y",
          "description": "Footprint copper-Pad bounding box centre, Y.",
          "type": "string"
        },
        {
          "const": "origin_x",
          "description": "Footprint origin, X.",
          "type": "string"
        },
        {
          "const": "origin_y",
          "description": "Footprint origin, Y.",
          "type": "string"
        },
        {
          "const": "pad1_x",
          "description": "Pad 1, X.",
          "type": "string"
        },
        {
          "const": "pad1_y",
          "description": "Pad 1, Y.",
          "type": "string"
        },
        {
          "const": "fitted",
          "description": "Whether the Component is fitted.",
          "type": "string"
        },
        {
          "const": "side",
          "description": "`Top` or `Bottom`, or the spellings from `side_values`.",
          "type": "string"
        },
        {
          "const": "rotation",
          "description": "The Footprint's rotation in degrees, counter-clockwise.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The Component field with this name, such as `LCSC` or `MPN`.",
          "properties": {
            "field": {
              "type": "string"
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        }
      ]
    },
    "CplSettings": {
      "additionalProperties": false,
      "properties": {
        "bottom_position": {
          "$ref": "#/$defs/BottomPosition"
        },
        "bottom_rotation": {
          "$ref": "#/$defs/BottomRotation"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "type": "array"
        },
        "exclude_through_hole": {
          "type": "boolean"
        },
        "side_values": {
          "$ref": "#/$defs/SideValues"
        },
        "unit_suffix": {
          "type": "boolean"
        },
        "units": {
          "$ref": "#/$defs/CplUnits"
        }
      },
      "required": [
        "columns",
        "side_values",
        "units",
        "unit_suffix",
        "bottom_rotation",
        "bottom_position",
        "exclude_through_hole"
      ],
      "type": "object"
    },
    "CplUnits": {
      "enum": [
        "mm",
        "mil",
        "in"
      ],
      "type": "string"
    },
    "FabRules": {
      "additionalProperties": false,
      "description": "A Fab Preset's design rules: flat limits with no scope, which a job compares the board\nwith, and the preferred values a new board's routing starts from.",
      "properties": {
        "annular_ring": {
          "description": "Minimum annular ring of Vias and plated Pads.",
          "format": "int64",
          "type": "integer"
        },
        "clearance": {
          "description": "Minimum clearance between copper of different Nets.",
          "format": "int64",
          "type": "integer"
        },
        "edge_clearance": {
          "description": "Minimum clearance from copper to the Board Outline and Board Cutouts.",
          "format": "int64",
          "type": "integer"
        },
        "hole_max": {
          "description": "Maximum Pad, Free Pad and non-plated hole.",
          "format": "int64",
          "type": "integer"
        },
        "hole_min": {
          "description": "Minimum Pad, Free Pad and non-plated hole.",
          "format": "int64",
          "type": "integer"
        },
        "hole_to_hole": {
          "description": "Minimum spacing between hole edges.",
          "format": "int64",
          "type": "integer"
        },
        "mask_expansion": {
          "$ref": "#/$defs/MaskExpansion"
        },
        "paste_expansion": {
          "$ref": "#/$defs/PasteExpansion"
        },
        "preferred": {
          "$ref": "#/$defs/PreferredSeeds",
          "description": "The preferred sizes a new board is seeded with. They are never compared with the\nboard."
        },
        "track_width": {
          "description": "Minimum Track width.",
          "format": "int64",
          "type": "integer"
        },
        "via_diameter": {
          "description": "Minimum Via diameter.",
          "format": "int64",
          "type": "integer"
        },
        "via_hole": {
          "description": "Minimum Via hole.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "clearance",
        "track_width",
        "via_diameter",
        "via_hole",
        "hole_min",
        "hole_max",
        "annular_ring",
        "hole_to_hole",
        "edge_clearance",
        "preferred",
        "mask_expansion",
        "paste_expansion"
      ],
      "type": "object"
    },
    "FileNaming": {
      "description": "How the Gerber and drill files of a job are named.",
      "oneOf": [
        {
          "const": "classic",
          "description": "Classic extensions: `.gtl`, `.gbl`, `.gts`, … and `.gm1` for the Profile.",
          "type": "string"
        },
        {
          "const": "descriptive",
          "description": "The project and Layer name, ending in `.gbr`.",
          "type": "string"
        }
      ]
    },
    "FileOrigin": {
      "enum": [
        "absolute",
        "relative"
      ],
      "type": "string"
    },
    "GerberSettings": {
      "additionalProperties": false,
      "description": "The Gerber and drill switches of a Fab Preset.",
      "properties": {
        "file_names": {
          "description": "Layer name to output file name; portable between boards and Projects.",
          "items": {
            "$ref": "#/$defs/LayerFileName"
          },
          "type": "array"
        },
        "file_origin": {
          "$ref": "#/$defs/FileOrigin",
          "description": "Shared by Gerber, drill and CPL."
        },
        "merge_drill": {
          "type": "boolean"
        },
        "naming": {
          "$ref": "#/$defs/FileNaming",
          "description": "How the files are named."
        },
        "outline_on_every_plot": {
          "type": "boolean"
        },
        "slot_command": {
          "$ref": "#/$defs/SlotCommand"
        },
        "x2_attributes": {
          "description": "Write Gerber X2 attributes (`.FileFunction` and friends); off writes plain X1.",
          "type": "boolean"
        }
      },
      "required": [
        "x2_attributes",
        "naming",
        "file_origin",
        "slot_command",
        "merge_drill",
        "outline_on_every_plot",
        "file_names"
      ],
      "type": "object"
    },
    "LayerFileName": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "layer",
        "name"
      ],
      "type": "object"
    },
    "LineNumbers": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "step": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "start",
        "step"
      ],
      "type": "object"
    },
    "MaskExpansion": {
      "additionalProperties": false,
      "description": "The board's solder-mask seed values. Tenting here applies only to Vias.",
      "properties": {
        "bottom": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "from_hole_edge": {
          "type": "boolean"
        },
        "tent_vias_bottom": {
          "type": "boolean"
        },
        "tent_vias_top": {
          "type": "boolean"
        },
        "top": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "top",
        "bottom",
        "from_hole_edge",
        "tent_vias_top",
        "tent_vias_bottom"
      ],
      "type": "object"
    },
    "MountValues": {
      "additionalProperties": false,
      "properties": {
        "smt": {
          "type": "string"
        },
        "tht": {
          "type": "string"
        }
      },
      "required": [
        "smt",
        "tht"
      ],
      "type": "object"
    },
    "NotFittedBom": {
      "enum": [
        "omit",
        "list"
      ],
      "type": "string"
    },
    "PasteExpansion": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expansion": {
              "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "expansion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "percent": {
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "percent"
          ],
          "type": "object"
        }
      ],
      "description": "The board's paste seed: length per edge or signed change in area in percent."
    },
    "PreferredSeeds": {
      "additionalProperties": false,
      "description": "The preferred Track and Via sizes a Fab Preset seeds a new board with.",
      "properties": {
        "track_width": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "via_diameter": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "via_hole": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "track_width",
        "via_diameter",
        "via_hole"
      ],
      "type": "object"
    },
    "SideValues": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "type": "string"
        },
        "top": {
          "type": "string"
        }
      },
      "required": [
        "top",
        "bottom"
      ],
      "type": "object"
    },
    "SlotCommand": {
      "enum": [
        "route",
        "g85"
      ],
      "type": "string"
    },
    "StackupSeeds": {
      "additionalProperties": false,
      "description": "A new board's Stackup values, from its Fab Preset. A value left out uses the fallback:\n[`DEFAULT_BOARD_THICKNESS`] and [`DEFAULT_COPPER`].",
      "properties": {
        "copper": {
          "description": "The copper thickness of every copper Layer.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "thickness": {
          "description": "The finished board thickness.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "StackupSuggestions": {
      "additionalProperties": false,
      "description": "Suggestions never validate the board or seed its finish or colours.",
      "properties": {
        "copper": {
          "items": {
            "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "finish": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mask_color": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "silk_color": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "thickness": {
          "items": {
            "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "thickness",
        "copper",
        "finish",
        "mask_color",
        "silk_color"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A REDA Fab Preset file (`.redafab`).",
  "properties": {
    "bom": {
      "$ref": "#/$defs/BomSettings",
      "description": "The BOM columns, in order."
    },
    "cpl": {
      "$ref": "#/$defs/CplSettings",
      "description": "The CPL columns, in order."
    },
    "format": {
      "const": 1,
      "description": "The file-format version. REDA writes only the current one.",
      "type": "integer"
    },
    "gerber": {
      "$ref": "#/$defs/GerberSettings",
      "description": "The Gerber and drill switches."
    },
    "name": {
      "description": "The preset's name, as the New Project dialog lists it.",
      "type": "string"
    },
    "rules": {
      "$ref": "#/$defs/FabRules",
      "description": "The flat limits a job checks the board against, and the preferred seeds of a new\nboard's rules."
    },
    "stackup": {
      "$ref": "#/$defs/StackupSeeds",
      "default": {},
      "description": "The thickness and copper a new board's Stackup starts with; left out when the\npreset seeds neither, and then a new board gets 1.6 mm and 1 oz."
    },
    "stackup_suggestions": {
      "$ref": "#/$defs/StackupSuggestions"
    },
    "zip_assembly": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "name",
    "rules",
    "gerber",
    "bom",
    "cpl",
    "zip_assembly",
    "stackup_suggestions"
  ],
  "title": "REDA Fab Preset file",
  "type": "object"
}
