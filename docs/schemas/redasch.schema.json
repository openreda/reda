{
  "$defs": {
    "ComponentRef": {
      "additionalProperties": false,
      "description": "Which Component an object refers to: its UUID, after the Sheet Instance path that\nleads to it. In v0.1 sheets are flat and the path is always empty.",
      "properties": {
        "path": {
          "description": "The Sheet Instances from the top sheet down. Empty in v0.1.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid"
      ],
      "type": "object"
    },
    "ComponentType": {
      "description": "Whether a part's Components go into the BOM and may exist only on the board.",
      "enum": [
        "standard",
        "mechanical"
      ],
      "type": "string"
    },
    "Field": {
      "additionalProperties": false,
      "description": "One free-form field.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "Fields": {
      "additionalProperties": false,
      "description": "A Part's default fields, copied onto each Component placed from it.",
      "properties": {
        "custom": {
          "description": "Free-form fields, such as `LCSC` or `DigiKey`, in the user's order.",
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "datasheet": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "mpn": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "FootprintCopyRow": {
      "additionalProperties": false,
      "description": "One copied Footprint: a `.redafp` file's keys in one row.",
      "properties": {
        "footprint": {
          "$ref": "#/$defs/FootprintRow"
        },
        "graphics": {
          "items": {
            "$ref": "#/$defs/FootprintGraphic"
          },
          "type": "array"
        },
        "hash": {
          "description": "The content hash of the Footprint, as copied.",
          "type": "string"
        },
        "pads": {
          "items": {
            "$ref": "#/$defs/Pad"
          },
          "type": "array"
        },
        "text": {
          "$ref": "#/$defs/FootprintTexts"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "hash",
        "footprint",
        "text",
        "pads",
        "graphics"
      ],
      "type": "object"
    },
    "FootprintGraphic": {
      "additionalProperties": false,
      "description": "One shape a Footprint draws on a non-copper Layer.",
      "properties": {
        "fill": {
          "description": "Whether a closed shape is filled.",
          "type": "boolean"
        },
        "layer": {
          "$ref": "#/$defs/FootprintLayer"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "width": {
          "description": "The stroke width.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uuid",
        "layer",
        "shape",
        "width"
      ],
      "type": "object"
    },
    "FootprintLayer": {
      "description": "The Layers a Footprint draws on besides copper.",
      "enum": [
        "silkscreen_top",
        "silkscreen_bottom",
        "courtyard_top",
        "courtyard_bottom",
        "assembly_top",
        "assembly_bottom"
      ],
      "type": "string"
    },
    "FootprintRow": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "name"
      ],
      "type": "object"
    },
    "FootprintText": {
      "additionalProperties": false,
      "description": "The placement of a Footprint's Designator or value text.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point",
          "description": "The text centre, relative to the Footprint origin."
        },
        "layer": {
          "$ref": "#/$defs/FootprintLayer"
        },
        "rotation": {
          "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "size": {
          "description": "The text height.",
          "format": "int64",
          "type": "integer"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "at",
        "rotation",
        "size",
        "layer"
      ],
      "type": "object"
    },
    "FootprintTexts": {
      "additionalProperties": false,
      "properties": {
        "designator": {
          "$ref": "#/$defs/FootprintText"
        },
        "value": {
          "$ref": "#/$defs/FootprintText"
        }
      },
      "required": [
        "designator",
        "value"
      ],
      "type": "object"
    },
    "Hole": {
      "additionalProperties": false,
      "description": "A drilled hole: round when `width == height`, otherwise a slot along the longer side.",
      "properties": {
        "height": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "width": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "Pad": {
      "additionalProperties": false,
      "description": "A copper area, with or without a hole, of a Footprint.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point",
          "description": "The Pad centre, relative to the Footprint origin."
        },
        "corner_radius": {
          "description": "The corner radius of a rounded-rectangle Pad.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "hole": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hole"
            },
            {
              "type": "null"
            }
          ],
          "description": "A round hole when width equals height, otherwise a slot. SMD Pads have none."
        },
        "kind": {
          "$ref": "#/$defs/PadKind"
        },
        "mask_margin": {
          "description": "Overrides the board's solder-mask margin for this Pad.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "number": {
          "type": "string"
        },
        "paste_margin": {
          "description": "Overrides the board's solder-paste margin for this Pad.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "rotation": {
          "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "shape": {
          "$ref": "#/$defs/PadShape"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "width": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uuid",
        "number",
        "kind",
        "shape",
        "at",
        "rotation",
        "width",
        "height"
      ],
      "type": "object"
    },
    "PadKind": {
      "enum": [
        "smd",
        "plated_through_hole",
        "non_plated"
      ],
      "type": "string"
    },
    "PadShape": {
      "enum": [
        "circle",
        "rect",
        "rounded_rect",
        "oval"
      ],
      "type": "string"
    },
    "PartEntryRow": {
      "additionalProperties": false,
      "description": "One part-table entry: a `.redapart` and a `.redasym` file's keys in one row.",
      "properties": {
        "copies": {
          "description": "The sheet's Footprint copy of each alternate, in the same order.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "fields": {
          "$ref": "#/$defs/Fields"
        },
        "footprints": {
          "description": "The alternate Footprints by Library UUID, the default first.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "graphics": {
          "items": {
            "$ref": "#/$defs/SymbolGraphic"
          },
          "type": "array"
        },
        "hash": {
          "description": "The content hash of the Part with its Symbol and Footprints, as copied.",
          "type": "string"
        },
        "part": {
          "$ref": "#/$defs/PartRow"
        },
        "pin_map": {
          "$ref": "#/$defs/PinMap"
        },
        "pins": {
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "type": "array"
        },
        "symbol": {
          "$ref": "#/$defs/SymbolRow"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/Unit"
          },
          "type": "array"
        },
        "uuid": {
          "description": "The entry's own UUID, which Units point at.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "hash",
        "part",
        "footprints",
        "copies",
        "fields",
        "pin_map",
        "symbol",
        "units",
        "pins",
        "graphics"
      ],
      "type": "object"
    },
    "PartRow": {
      "additionalProperties": false,
      "properties": {
        "component_type": {
          "$ref": "#/$defs/ComponentType"
        },
        "name": {
          "type": "string"
        },
        "symbol": {
          "description": "The Symbol by UUID. Mechanical Parts may have none.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "name",
        "component_type"
      ],
      "type": "object"
    },
    "Pin": {
      "additionalProperties": false,
      "description": "A connection point of a Symbol.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point",
          "description": "The connection end of the Pin, relative to the Symbol origin."
        },
        "electrical_type": {
          "$ref": "#/$defs/PinType"
        },
        "length": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "name_visible": {
          "description": "Whether the Pin's name is drawn.",
          "type": "boolean"
        },
        "number": {
          "description": "Unique across the Symbol; Pins map to the Pads with the same number unless the\nPart overrides it.",
          "type": "string"
        },
        "number_visible": {
          "description": "Whether the Pin's number is drawn.",
          "type": "boolean"
        },
        "rotation": {
          "description": "The direction from the connection end towards the body, counter-clockwise from +x.",
          "format": "int64",
          "type": "integer"
        },
        "unit": {
          "description": "The Unit it belongs to.",
          "format": "uuid",
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "unit",
        "name",
        "number",
        "electrical_type",
        "at",
        "rotation",
        "length"
      ],
      "type": "object"
    },
    "PinMap": {
      "additionalProperties": false,
      "description": "The Part's exceptions to the implicit map, where a Pin connects to the Pads with its\nown number.",
      "properties": {
        "pins": {
          "description": "Pins mapped to other Pads, or to several, sorted by Pin number.",
          "items": {
            "$ref": "#/$defs/PinPads"
          },
          "type": "array"
        },
        "unconnected": {
          "description": "Pad numbers deliberately left unconnected, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PinPads": {
      "additionalProperties": false,
      "description": "One Pin mapped to an explicit set of Pads.",
      "properties": {
        "pads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pin": {
          "type": "string"
        }
      },
      "required": [
        "pin",
        "pads"
      ],
      "type": "object"
    },
    "PinType": {
      "description": "A Pin's electrical type, which ERC checks.",
      "enum": [
        "input",
        "output",
        "bidirectional",
        "tri_state",
        "passive",
        "power_in",
        "power_out",
        "open_collector",
        "open_emitter",
        "not_connected"
      ],
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A position on a Schematic Sheet or the PCB Document, which share one coordinate type.",
      "properties": {
        "x": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Shape": {
      "description": "A drawn shape. Lines, arcs and outlines are stroked with the graphic's width.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "end": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "line",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An axis-aligned rectangle between two opposite corners.",
          "properties": {
            "end": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "rect",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Point"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The arc from `start` around `center`, sweeping `sweep` counter-clockwise (negative\nis clockwise).",
          "properties": {
            "center": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "arc",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Point"
            },
            "sweep": {
              "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "center",
            "start",
            "sweep"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "center": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "const": "circle",
              "type": "string"
            },
            "radius": {
              "description": "A length or coordinate in integer nanometres. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "center",
            "radius"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A closed polygon through its corners.",
          "properties": {
            "kind": {
              "const": "polygon",
              "type": "string"
            },
            "points": {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "points"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "$ref": "#/$defs/Point",
              "description": "The text's anchor."
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "rotation": {
              "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
              "format": "int64",
              "type": "integer"
            },
            "size": {
              "description": "The text height.",
              "format": "int64",
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "text",
            "size",
            "rotation"
          ],
          "type": "object"
        }
      ]
    },
    "SheetFrame": {
      "additionalProperties": false,
      "description": "A sheet's frame settings. A sheet has at most one; with none it uses the defaults.",
      "properties": {
        "size": {
          "$ref": "#/$defs/SheetSize"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "size"
      ],
      "type": "object"
    },
    "SheetRow": {
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "required": [
        "uuid"
      ],
      "type": "object"
    },
    "SheetSize": {
      "description": "A sheet's paper size. Sheets are landscape.",
      "enum": [
        "a4",
        "a3",
        "a2",
        "a1",
        "a0",
        "letter",
        "legal",
        "tabloid"
      ],
      "type": "string"
    },
    "SymbolGraphic": {
      "additionalProperties": false,
      "description": "One shape of a Symbol Unit's body.",
      "properties": {
        "fill": {
          "description": "Whether a closed shape is filled.",
          "type": "boolean"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "unit": {
          "description": "The Unit it is drawn on.",
          "format": "uuid",
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "width": {
          "description": "The stroke width.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "uuid",
        "unit",
        "shape",
        "width"
      ],
      "type": "object"
    },
    "SymbolRow": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "designator_prefix": {
          "description": "The Designator prefix of Components placed from it, such as `R` or `U`.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "name",
        "designator_prefix"
      ],
      "type": "object"
    },
    "Unit": {
      "additionalProperties": false,
      "description": "One independently placeable section of a Symbol.",
      "properties": {
        "name": {
          "description": "Such as `A`, or `Power` for a power section.",
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "name"
      ],
      "type": "object"
    },
    "UnitInstance": {
      "additionalProperties": false,
      "description": "One placed Unit of a Component. Every Unit of a Component carries the same copy of the\nComponent's data; Commands keep the copies equal.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Point",
          "description": "Where the Symbol origin sits on the sheet."
        },
        "component": {
          "$ref": "#/$defs/ComponentRef"
        },
        "component_type": {
          "$ref": "#/$defs/ComponentType"
        },
        "designator": {
          "type": "string"
        },
        "designator_locked": {
          "description": "Locked against Re-annotate, which then leaves the Designator as it is.",
          "type": "boolean"
        },
        "fields": {
          "$ref": "#/$defs/Fields",
          "description": "The value is `fields.value`."
        },
        "footprint": {
          "description": "The chosen Footprint: the UUID of one of the Part's alternates, if it has any.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "mirror": {
          "description": "Mirrored left to right before rotating.",
          "type": "boolean"
        },
        "not_fitted": {
          "type": "boolean"
        },
        "part": {
          "description": "The part-table entry on this sheet it was placed from.",
          "format": "uuid",
          "type": "string"
        },
        "rotation": {
          "description": "An angle in integer millidegrees, counter-clockwise. Serialises as a bare integer.",
          "format": "int64",
          "type": "integer"
        },
        "unit": {
          "description": "The Symbol Unit it shows.",
          "format": "uuid",
          "type": "string"
        },
        "uuid": {
          "format": "uuid",
          "type": "string"
        },
        "visible_fields": {
          "description": "The fields drawn on the sheet, by name: `designator`, a built-in field's stored name\n(such as `value`) or a free-form field's name. Designator and value by default.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "uuid",
        "component",
        "part",
        "unit",
        "at",
        "rotation",
        "designator",
        "fields",
        "component_type"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A REDA Schematic Sheet file (`.redasch`).",
  "properties": {
    "footprints": {
      "default": [],
      "description": "The copied Footprints the part table's entries share, sorted by UUID.",
      "items": {
        "$ref": "#/$defs/FootprintCopyRow"
      },
      "type": "array"
    },
    "format": {
      "const": 1,
      "description": "The file-format version. REDA writes only the current one.",
      "type": "integer"
    },
    "frame": {
      "anyOf": [
        {
          "$ref": "#/$defs/SheetFrame"
        },
        {
          "type": "null"
        }
      ],
