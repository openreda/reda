{
  "commands": [
    {
      "category": "app",
      "description": "Reads the user's Preferences: one key with its default and description, or every value with warnings for keys in preferences.toml that were ignored.",
      "icon": "preferences",
      "id": "app.preferences.get",
      "kind": "file",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "key": {
            "default": null,
            "description": "A dotted key such as `schematic.repeat_placement`. Without one, every Preference.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "GetParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "AnyValue"
      },
      "title": "Get Preferences"
    },
    {
      "category": "app",
      "description": "Sets one Preference in the user's preferences.toml, keeping every other line and comment. Null, or the default value, removes the key.",
      "icon": "preferences",
      "id": "app.preferences.set",
      "kind": "file",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "key": {
            "description": "A dotted key such as `schematic.repeat_placement`.",
            "type": "string"
          },
          "value": {
            "description": "The new value; `null` resets the key to its default."
          }
        },
        "required": [
          "key",
          "value"
        ],
        "title": "SetParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "AnyValue"
      },
      "title": "Set Preference"
    },
    {
      "category": "edit",
      "description": "Runs several edit and query Commands as one atomic edit: if any step fails, every step is rolled back. Later steps refer to objects created by earlier ones through UUIDs the caller supplied in the earlier step's params. Returns the combined changes and each step's result, in order.",
      "icon": "batch",
      "id": "batch",
      "kind": "edit",
      "params": {
        "$defs": {
          "BatchStep": {
            "additionalProperties": false,
            "description": "One step of a batch.",
            "properties": {
              "id": {
                "description": "An edit or query Command id, or one of their Presets as `<id>:<preset>`.",
                "type": "string"
              },
              "params": {
                "default": null,
                "description": "The step's params, as the Command takes them on its own."
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "The params of `batch`.",
        "properties": {
          "commands": {
            "description": "The steps, run in order.",
            "items": {
              "$ref": "#/$defs/BatchStep"
            },
            "type": "array"
          }
        },
        "required": [
          "commands"
        ],
        "title": "BatchParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "items": true,
        "title": "Array_of_AnyValue",
        "type": "array"
      },
      "title": "Batch"
    },
    {
      "category": "edit",
      "description": "Redoes the newest undone edit on one undo stack: a Document's, or the Project file's with `document: \"project\"`. Any new edit on that stack clears what could be redone.",
      "icon": "redo",
      "id": "edit.redo",
      "kind": "edit",
      "params": {
        "$defs": {
          "DocumentRef": {
            "anyOf": [
              {
                "const": "project",
                "type": "string"
              },
              {
                "format": "uuid",
                "type": "string"
              }
            ],
            "description": "One file of the Project: \"project\" for the Project file, or a Document's UUID."
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "document": {
            "$ref": "#/$defs/DocumentRef",
            "description": "The stack: a Document's UUID, or `\"project\"` for the Project file's own stack."
          }
        },
        "required": [
          "document"
        ],
        "title": "StackParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "label": {
            "description": "The label of the entry undone or redone, such as \"Add Wire\".",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "title": "StepResult",
        "type": "object"
      },
      "title": "Redo"
    },
    {
      "category": "edit",
      "description": "Undoes the newest edit on one undo stack: a Document's, or the Project file's with `document: \"project\"`. A cross-Document edit has one entry in each Document it touched, undone independently.",
      "icon": "undo",
      "id": "edit.undo",
      "kind": "edit",
      "params": {
        "$defs": {
          "DocumentRef": {
            "anyOf": [
              {
                "const": "project",
                "type": "string"
              },
              {
                "format": "uuid",
                "type": "string"
              }
            ],
            "description": "One file of the Project: \"project\" for the Project file, or a Document's UUID."
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "document": {
            "$ref": "#/$defs/DocumentRef",
            "description": "The stack: a Document's UUID, or `\"project\"` for the Project file's own stack."
          }
        },
        "required": [
          "document"
        ],
        "title": "StackParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "label": {
            "description": "The label of the entry undone or redone, such as \"Add Wire\".",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "title": "StepResult",
        "type": "object"
      },
      "title": "Undo"
    },
    {
      "category": "library",
      "description": "Scans the registered Libraries (the starter Library, the user's from Preferences and the Project's) and returns the Parts whose name or field values contain `text`, optionally only from one Library or of one Component Type.",
      "icon": "search",
      "id": "library.search",
      "kind": "file",
      "params": {
        "$defs": {
          "ComponentType": {
            "description": "Whether a part's Components go into the BOM and may exist only on the board.",
            "enum": [
              "standard",
              "mechanical"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "component_type": {
            "anyOf": [
              {
                "$ref": "#/$defs/ComponentType"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only Parts of this Component Type."
          },
          "library": {
            "default": null,
            "description": "Only Parts of the Library with this UUID.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "default": "",
            "description": "Matched, ignoring case, as a substring of a Part's name or any of its field values\n(Value, Description, Keywords, MPN, the free-form fields…). Empty matches every Part.",
            "type": "string"
          }
        },
        "title": "SearchParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$defs": {
          "ComponentType": {
            "description": "Whether a part's Components go into the BOM and may exist only on the board.",
            "enum": [
              "standard",
              "mechanical"
            ],
            "type": "string"
          },
          "Field": {
            "additionalProperties": false,
            "description": "One free-form field.",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "type": "object"
          },
          "Fields": {
            "additionalProperties": false,
            "description": "A Part's default fields, copied onto each Component placed from it.",
            "properties": {
              "custom": {
                "description": "Free-form fields, such as `LCSC` or `DigiKey`, in the user's order.",
                "items": {
                  "$ref": "#/$defs/Field"
                },
                "type": "array"
              },
              "datasheet": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "keywords": {
                "type": "string"
              },
              "manufacturer": {
                "type": "string"
              },
              "mpn": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "LibrarySummary": {
            "description": "One scanned Library.",
            "properties": {
              "name": {
                "type": "string"
              },
              "origin": {
                "$ref": "#/$defs/Origin"
              },
              "path": {
                "description": "The Library folder.",
                "type": "string"
              },
              "uuid": {
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "uuid",
              "name",
              "origin",
              "path"
            ],
            "type": "object"
          },
          "Origin": {
            "description": "How a Library came to be registered.",
            "oneOf": [
              {
                "const": "starter",
                "description": "The starter Library that ships with REDA. Read-only.",
                "type": "string"
              },
              {
                "const": "user",
                "description": "Listed in the user's Preferences.",
                "type": "string"
              },
              {
                "const": "project",
                "description": "Listed in the open Project's `.reda` file.",
                "type": "string"
              }
            ]
          },
          "PartHit": {
            "description": "One Part found.",
            "properties": {
              "component_type": {
                "$ref": "#/$defs/ComponentType"
              },
              "fields": {
                "$ref": "#/$defs/Fields"
              },
              "footprints": {
                "description": "The alternate Footprints, the default first.",
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "type": "array"
              },
              "library": {
                "$ref": "#/$defs/LibrarySummary"
              },
              "name": {
                "type": "string"
              },
              "symbol": {
                "format": "uuid",
                "type": [
                  "string",
                  "null"
                ]
              },
              "uuid": {
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "uuid",
              "name",
              "component_type",
              "symbol",
              "footprints",
              "fields",
              "library"
            ],
            "type": "object"
          },
          "ScanProblem": {
            "description": "A file or folder a scan could not use, and why.",
            "properties": {
              "message": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "libraries": {
            "description": "Every registered Library that scanned, in scan order.",
            "items": {
              "$ref": "#/$defs/LibrarySummary"
            },
            "type": "array"
          },
          "parts": {
            "description": "The matching Parts, sorted by name.",
            "items": {
              "$ref": "#/$defs/PartHit"
            },
            "type": "array"
          },
          "problems": {
            "description": "Folders and files that could not be used, and why.",
            "items": {
              "$ref": "#/$defs/ScanProblem"
            },
            "type": "array"
          }
        },
        "required": [
          "libraries",
          "parts",
          "problems"
        ],
        "title": "SearchResult",
        "type": "object"
      },
      "title": "Search Libraries"
    },
    {
      "category": "query",
      "description": "Returns the object with this UUID, whatever its type, and the Document it lives in.",
      "icon": "inspect",
      "id": "object.get",
      "kind": "query",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "uuid": {
            "description": "The object's UUID.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid"
        ],
        "title": "ObjectGetParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$defs": {
          "DocumentKind": {
            "description": "What kind of Document an entry is.",
            "enum": [
              "schematic"
            ],
            "type": "string"
          },
          "Object": {
            "description": "Any persisted object addressable by UUID, tagged with its `type`.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Project-wide properties, stored in `<name>.reda`.\n\nThe Document order lives here because it is a Project property: it drives sheet\nnumbering and PDF output, and reordering is an edit on the Project's own undo stack.",
                "properties": {
                  "documents": {
                    "description": "Every Document's UUID, in Project order.",
                    "items": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "libraries": {
                    "description": "The Project Libraries: folders relative to the Project folder, `/`-separated.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "project",
                    "type": "string"
                  },
                  "uuid": {
                    "format": "uuid",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "uuid",
                  "name",
                  "documents"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "One Document in the Project's Document list, stored in `<name>.reda`.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/DocumentKind"
                  },
                  "name": {
                    "description": "The file stem; the Document's file is `<name>.<extension>` in the Project folder.",
                    "type": "string"
                  },
                  "title": {
                    "description": "What the user typed as the Document's title, such as \"Sheet 1\".",
                    "type": "string"
                  },
                  "type": {
                    "const": "document",
                    "type": "string"
                  },
                  "uuid": {
                    "format": "uuid",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "uuid",
                  "kind",
                  "name",
                  "title"
                ],
                "type": "object"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "An object and the Document it lives in.",
        "properties": {
          "document": {
            "description": "The Document holding the object, or `null` for objects in the Project file.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "$ref": "#/$defs/Object"
          }
        },
        "required": [
          "document",
          "object"
        ],
        "title": "ObjectView",
        "type": "object"
      },
      "title": "Get Object"
    },
    {
      "category": "query",
      "description": "Lists the objects that match every given filter, sorted by UUID: `document` keeps the objects in one Document, `type` the objects of one type. With no filter it lists every object in the Project.",
      "icon": "search",
      "id": "objects.query",
      "kind": "query",
      "params": {
        "$defs": {
          "ObjectType": {
            "description": "The type of an object, as its `type` tag names it.",
            "oneOf": [
              {
                "const": "project",
                "description": "The Project's own properties, in the Project file.",
                "type": "string"
              },
              {
                "const": "document",
                "description": "A Document's entry in the Project's Document list.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "document": {
            "default": null,
            "description": "Only objects in this Document. Document entries themselves live in the Project file.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "anyOf": [
              {
                "$ref": "#/$defs/ObjectType"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only objects of this type."
          }
        },
        "title": "ObjectsQueryParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$defs": {
          "DocumentKind": {
            "description": "What kind of Document an entry is.",
            "enum": [
              "schematic"
            ],
            "type": "string"
          },
          "Object": {
            "description": "Any persisted object addressable by UUID, tagged with its `type`.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Project-wide properties, stored in `<name>.reda`.\n\nThe Document order lives here because it is a Project property: it drives sheet\nnumbering and PDF output, and reordering is an edit on the Project's own undo stack.",
                "properties": {
                  "documents": {
                    "description": "Every Document's UUID, in Project order.",
                    "items": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "libraries": {
                    "description": "The Project Libraries: folders relative to the Project folder, `/`-separated.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "project",
                    "type": "string"
                  },
                  "uuid": {
                    "format": "uuid",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "uuid",
                  "name",
                  "documents"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "One Document in the Project's Document list, stored in `<name>.reda`.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/DocumentKind"
                  },
                  "name": {
                    "description": "The file stem; the Document's file is `<name>.<extension>` in the Project folder.",
                    "type": "string"
                  },
                  "title": {
                    "description": "What the user typed as the Document's title, such as \"Sheet 1\".",
                    "type": "string"
                  },
                  "type": {
                    "const": "document",
                    "type": "string"
                  },
                  "uuid": {
                    "format": "uuid",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "uuid",
                  "kind",
                  "name",
                  "title"
                ],
                "type": "object"
              }
            ]
          },
          "ObjectView": {
            "description": "An object and the Document it lives in.",
            "properties": {
              "document": {
                "description": "The Document holding the object, or `null` for objects in the Project file.",
                "format": "uuid",
                "type": [
                  "string",
                  "null"
                ]
              },
              "object": {
                "$ref": "#/$defs/Object"
              }
            },
            "required": [
              "document",
              "object"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "What `objects.query` returns.",
        "properties": {
          "objects": {
            "description": "Sorted by UUID.",
            "items": {
              "$ref": "#/$defs/ObjectView"
            },
            "type": "array"
          }
        },
        "required": [
          "objects"
        ],
        "title": "QueryResult",
        "type": "object"
      },
      "title": "Query Objects"
    },
    {
      "category": "library",
      "description": "Registers a Library folder with the Project. The path is relative to the Project folder and is stored in the `.reda` file, so the Library travels with the Project.",
      "icon": "library_add",
      "id": "project.library.add",
      "kind": "edit",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Params naming one Project Library folder.",
        "properties": {
          "path": {
            "description": "The Library folder, relative to the Project folder, such as `parts` or\n`../shared/libs`. Either slash separates folders.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "LibraryPathParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The Project Library paths after the edit, in order.",
        "properties": {
          "libraries": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "libraries"
        ],
        "title": "LibraryPathResult",
        "type": "object"
      },
      "title": "Add Project Library"
    },
    {
      "category": "library",
      "description": "Unregisters a Library folder from the Project. The folder and its files stay on disk.",
      "icon": "library_remove",
      "id": "project.library.remove",
      "kind": "edit",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Params naming one Project Library folder.",
        "properties": {
          "path": {
            "description": "The Library folder, relative to the Project folder, such as `parts` or\n`../shared/libs`. Either slash separates folders.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "LibraryPathParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The Project Library paths after the edit, in order.",
        "properties": {
          "libraries": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "libraries"
        ],
        "title": "LibraryPathResult",
        "type": "object"
      },
      "title": "Remove Project Library"
    },
    {
      "category": "project",
      "description": "Creates a Project called `name` in the folder `<path>/<name>/` with one empty Schematic Sheet titled \"Sheet 1\", and opens it. The folder must not exist or be empty. Nothing is written until `project.save`.",
      "icon": "project_new",
      "id": "project.new",
      "kind": "file",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "The Project name: its folder name and the stem of its `.reda` file.",
            "type": "string"
          },
          "path": {
            "description": "The folder in which the Project's own folder `<path>/<name>/` is created.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "name"
        ],
        "title": "ProjectNewParams",
        "type": "object"
      },
      "presets": [],
      "result": {
        "$defs": {
          "DocumentEntry": {
            "additionalProperties": false,
            "description": "One Document in the Project's Document list, stored in `<name>.reda`.",
            "properties": {
              "kind": {
                "$ref": "#/$defs/DocumentKind"
              },
              "name": {
