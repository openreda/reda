(module SOP8_EXAMPLE (layer F.Cu) (tedit 5F000000)
  (descr "Made-up 8-pin through-hole package for the REDA tests")
  (fp_text reference REF** (at 0 -6.5 90) (layer F.SilkS)
    (effects (font (size 1.2 1.2) (thickness 0.15)))
  )
  (fp_text value SOP8_EXAMPLE (at 0 6.5) (layer F.Fab) hide
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "Copyright 2026 Example Parts Service. All rights reserved." (at 0 0) (layer Cmts.User)
    (effects (font (size 0.5 0.5) (thickness 0.05)))
  )
  (fp_text user PIN1 (at -5 -4) (layer F.SilkS)
    (effects (font (size 0.8 0.8) (thickness 0.1)))
  )
  (fp_line (start -2 -5) (end 2 -5) (layer F.SilkS) (width 0.12))
  (fp_arc (start 0 -5) (end -1 -5) (angle -180) (layer F.SilkS) (width 0.12))
  (fp_poly (pts (xy -3 -3) (xy 3 -3) (xy 3 3) (xy -3 3)) (layer F.Fab) (width 0.1))
  (fp_line (start -6 -6) (end 6 -6) (layer F.CrtYd) (width 0.05))
  (fp_line (start 6 -6) (end 6 6) (layer B.CrtYd) (width 0.05))
  (fp_line (start -7 -7) (end 7 -7) (layer Edge.Cuts) (width 0.05))
  (pad 1 thru_hole rect (at -3.81 -3.81) (size 1.6 1.6) (drill 0.8) (layers *.Cu *.Mask))
  (pad 2 thru_hole oval (at -3.81 -1.27) (size 1.6 1.2) (drill 0.8) (layers *.Cu *.Mask))
  (pad 3 thru_hole oval (at -3.81 1.27) (size 1.6 1.2) (drill 0.8) (layers *.Cu *.Mask))
  (pad 4 thru_hole oval (at -3.81 3.81) (size 1.6 1.2) (drill 0.8) (layers *.Cu *.Mask))
  (pad 5 thru_hole oval (at 3.81 3.81) (size 1.6 1.2) (drill 0.8) (layers *.Cu *.Mask))
  (pad 6 thru_hole oval (at 3.81 1.27) (size 1.6 1.2) (drill 0.8) (layers *.Cu *.Mask))
  (pad 7 thru_hole oval (at 3.81 -1.27) (size 1.6 1.2) (drill 0.8) (layers *.Cu *.Mask))
  (pad 8 thru_hole circle (at 3.81 -3.81) (size 1.6 1.6) (drill oval 0.8 1.2) (layers *.Cu *.Mask)
    (solder_mask_margin 0.05))
  (pad "" np_thru_hole circle (at 0 0) (size 1.5 1.5) (drill 1.5) (layers *.Cu *.Mask))
  (model C:\\Users\\someone\\Parts.3dshapes\\SOP8_EXAMPLE.stp
    (at (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0))
  )
)
