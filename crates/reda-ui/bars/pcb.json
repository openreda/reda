{
  "menus": [
    {
      "id": "edit",
      "title": "menu-edit",
      "items": [
        { "id": "edit.copy", "command": "pcb.copy", "params": { "objects": "$selection" }, "title": "menu-edit-copy" },
        { "id": "edit.paste", "command": "pcb.paste", "params": { "clipboard": "$clipboard" }, "title": "menu-edit-paste" },
        { "id": "edit.paste_special", "command": "pcb.paste", "params": { "clipboard": "$clipboard", "keep_nets": true, "layer": "$active_layer" }, "title": "menu-edit-paste-special" },
        "separator",
        { "id": "edit.move_by", "command": "pcb.move", "params": { "objects": "$selection" }, "title": "menu-edit-move-by" },
        { "id": "edit.move_by_points", "command": "tool.activate:move_by" },
        { "id": "edit.rotate_about", "command": "tool.rotate_about" },
        { "id": "edit.swap", "command": "tool.activate:swap" },
        { "id": "edit.arrange_outside_board", "command": "pcb.arrange_outside_board", "params": { "footprints": "$selection" } },
        "separator",
        { "id": "edit.lock", "command": "pcb.lock", "params": { "objects": "$selection", "locked": true }, "title": "menu-edit-lock" },
        { "id": "edit.unlock", "command": "pcb.lock", "params": { "objects": "$selection", "locked": false }, "title": "menu-edit-unlock" }
      ]
    },
    {
      "id": "view",
      "title": "menu-view",
      "items": [
        { "id": "view.units_toggle", "command": "view.units.toggle" },
        { "id": "view.grid_cycle", "command": "view.grid.cycle", "params": { "document": "$active_document" } },
        "separator",
        { "id": "view.layer_next", "command": "pcb.layer.step:next" },
        { "id": "view.layer_previous", "command": "pcb.layer.step:previous" },
        { "id": "view.layer_swap_side", "command": "pcb.layer.swap_side" },
        { "id": "view.inactive_layers", "command": "pcb.view.inactive_layers" },
        { "id": "view.from_bottom", "command": "pcb.view.from_bottom" },
        { "id": "view.ratsnest", "command": "pcb.ratsnest.show" },
        "separator",
        { "id": "view.cross_select", "command": "view.cross_select.toggle" },
        { "id": "view.net_cross_probe", "command": "view.net_cross_probe.toggle" }
      ]
    },
    {
      "id": "place",
      "title": "menu-place",
      "items": [
        { "id": "place.board_outline", "command": "tool.activate:board_outline" },
        { "id": "place.board_outline_rect", "command": "tool.activate:board_outline_rect" },
        { "id": "place.board_outline_from_selection", "command": "pcb.board_outline.add_from_graphics", "params": { "graphics": "$selection" } },
        { "id": "place.board_cutout", "command": "tool.activate:board_cutout" },
        "separator",
        { "id": "place.zone", "command": "tool.activate:zone" },
        { "id": "place.keepout", "command": "tool.activate:keepout" },
        { "id": "place.zone_cutout", "command": "tool.activate:zone_cutout" },
        { "id": "place.zone_from_board_outline", "command": "pcb.zone.add_from_board_outline", "params": { "layers": ["$active_layer"], "net": "$highlighted_net" }, "title": "pcb-zone-from-board-outline" },
        { "id": "place.zone_from_selection", "command": "pcb.zone.add_from_graphics", "params": { "graphics": "$selection", "layer": "$active_layer", "net": "$highlighted_net" } },
        { "id": "place.zone_cutout_from_selection", "command": "pcb.zone_cutout.add_from_graphics", "params": { "graphics": "$selection", "layer": "$active_layer" } },
        { "id": "place.keepout_from_selection", "command": "pcb.keepout.add_from_graphics", "params": { "graphics": "$selection" } },
        { "id": "place.board_cutout_from_selection", "command": "pcb.board_cutout.add_from_graphics", "params": { "graphics": "$selection" } },
        "separator",
        { "id": "place.text", "command": "tool.activate:text" },
        { "id": "place.line", "command": "tool.activate:line" },
        { "id": "place.arc", "command": "tool.activate:arc" },
        { "id": "place.rect", "command": "tool.activate:rect" },
        "separator",
        { "id": "place.free_pad", "command": "tool.activate:free_pad" },
        { "id": "place.output_origin", "command": "tool.activate:output_origin" },
        { "id": "place.output_origin_delete", "command": "pcb.output_origin.delete" }
      ]
    },
    {
      "id": "design",
      "title": "menu-design",
      "items": [
        { "id": "design.drc", "command": "drc.run" },
        "separator",
        { "id": "design.move_board_shape", "command": "tool.move_board_shape" },
        { "id": "design.move_board", "command": "tool.move_board" },
        "separator",
        { "id": "design.update_from_library", "command": "pcb.update_from_library.open" }
      ]
    },
    {
      "id": "route",
      "title": "menu-route",
      "items": [
        { "id": "route.track", "command": "tool.activate:route" },
        { "id": "route.via", "command": "tool.activate:via" },
        "separator",
        { "id": "route.zone_fill", "command": "pcb.zone.fill" },
        { "id": "route.ratsnest", "command": "pcb.ratsnest" }
      ]
    },
    {
      "id": "tools",
      "title": "menu-tools",
      "items": [
        { "id": "tools.measure", "command": "tool.activate:measure" },
        "separator",
        { "id": "tools.silkscreen_prepare", "command": "pcb.silkscreen.prepare" }
      ]
    }
  ],
  "toolbar": [
    { "id": "toolbar.units", "command": "view.units.toggle" },
    { "id": "toolbar.from_bottom", "command": "pcb.view.from_bottom" }
  ],
  "active_bar": [
    { "id": "active_bar.select", "command": "tool.activate:select" },
    "separator",
    { "id": "active_bar.route", "command": "tool.activate:route" },
    { "id": "active_bar.via", "command": "tool.activate:via" },
    { "id": "active_bar.zone", "command": "tool.activate:zone" },
    "separator",
    { "id": "active_bar.layers", "command": "panel.show:layers" }
  ],
  "tool_bars": {
    "place": [
      { "id": "place_bar.obstacle_mode", "command": "pcb.place.mode:obstacle_mode" },
      { "id": "place_bar.alignment_guides", "command": "pcb.place.mode:alignment_guides" },
      { "id": "place_bar.ratsnest_mode", "command": "pcb.place.mode:ratsnest_mode" },
      "separator",
      { "id": "place_bar.rotate", "command": "tool.rotate" },
      { "id": "place_bar.flip", "command": "tool.flip_side" },
      { "id": "place_bar.queue", "command": "pcb.place.skip" },
      "separator",
      { "id": "place_bar.keys", "command": "view.keys_card.toggle" }
    ],
    "route": [
      { "id": "route_bar.width", "command": "pcb.route.chooser:width" },
      { "id": "route_bar.corner", "command": "tool.cycle_corner" },
      { "id": "route_bar.lookahead", "command": "pcb.route.mode:lookahead" },
      { "id": "route_bar.obstacle_mode", "command": "pcb.route.mode:obstacle_mode" },
      { "id": "route_bar.auto_terminate", "command": "pcb.route.mode:auto_terminate" },
      { "id": "route_bar.loop_removal", "command": "pcb.route.mode:loop_removal" },
      { "id": "route_bar.clearance_display", "command": "pcb.route.mode:clearance_display" },
      "separator",
      { "id": "route_bar.keys", "command": "view.keys_card.toggle" }
    ]
  }
}
