{
  "menus": [
    {
      "id": "view",
      "title": "menu-view",
      "items": [
        { "id": "view.units_toggle", "command": "view.units.toggle" },
        { "id": "view.grid_cycle", "command": "view.grid.cycle", "params": { "document": "$active_document" } },
        "separator",
        { "id": "view.layer_next", "command": "pcb.layer.step:next" },
        { "id": "view.layer_previous", "command": "pcb.layer.step:previous" },
        { "id": "view.layer_swap_side", "command": "pcb.layer.swap_side" },
        { "id": "view.inactive_layers", "command": "pcb.view.inactive_layers" },
        { "id": "view.from_bottom", "command": "pcb.view.from_bottom" },
        { "id": "view.ratsnest", "command": "pcb.ratsnest.show" },
        "separator",
        { "id": "view.cross_select", "command": "view.cross_select.toggle" },
        { "id": "view.net_cross_probe", "command": "view.net_cross_probe.toggle" }
      ]
    },
    {
      "id": "place",
      "title": "menu-place",
      "items": [
        { "id": "place.board_outline", "command": "tool.activate:board_outline" },
        { "id": "place.board_outline_rect", "command": "tool.activate:board_outline_rect" },
        { "id": "place.board_outline_from_selection", "command": "pcb.board_outline.add_from_graphics", "params": { "graphics": "$selection" } },
        { "id": "place.board_cutout", "command": "tool.activate:board_cutout" },
        "separator",
        { "id": "place.zone", "command": "tool.activate:zone" },
        { "id": "place.keepout", "command": "tool.activate:keepout" },
        "separator",
        { "id": "place.text", "command": "tool.activate:text" },
        { "id": "place.line", "command": "tool.activate:line" },
        { "id": "place.arc", "command": "tool.activate:arc" },
        { "id": "place.rect", "command": "tool.activate:rect" },
        "separator",
        { "id": "place.free_pad", "command": "tool.activate:free_pad" },
        { "id": "place.output_origin", "command": "tool.activate:output_origin" },
        { "id": "place.output_origin_delete", "command": "pcb.output_origin.delete" }
      ]
    },
    {
      "id": "design",
      "title": "menu-design",
      "items": [
        { "id": "design.drc", "command": "drc.run" },
        "separator",
        { "id": "design.move_board_shape", "command": "tool.move_board_shape" }
      ]
    },
    {
      "id": "route",
      "title": "menu-route",
      "items": [
        { "id": "route.track", "command": "tool.activate:route" },
        { "id": "route.via", "command": "tool.activate:via" },
        "separator",
        { "id": "route.zone_fill", "command": "pcb.zone.fill" },
        { "id": "route.ratsnest", "command": "pcb.ratsnest" }
      ]
    },
    {
      "id": "tools",
      "title": "menu-tools",
      "items": [
        { "id": "tools.measure", "command": "tool.activate:measure" }
      ]
    }
  ],
  "toolbar": [
    { "id": "toolbar.units", "command": "view.units.toggle" },
    { "id": "toolbar.from_bottom", "command": "pcb.view.from_bottom" }
  ],
  "active_bar": [
    { "id": "active_bar.select", "command": "tool.activate:select" },
    "separator",
    { "id": "active_bar.route", "command": "tool.activate:route" },
    { "id": "active_bar.via", "command": "tool.activate:via" },
    { "id": "active_bar.zone", "command": "tool.activate:zone" },
    "separator",
    { "id": "active_bar.layers", "command": "panel.show:layers" }
  ]
}
