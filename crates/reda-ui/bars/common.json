{
  "menus": [
    {
      "id": "file",
      "title": "menu-file",
      "items": [
        { "id": "file.new_project", "command": "app.dialog.open:new_project" },
        { "id": "file.open_project", "command": "app.dialog.open:open_project" },
        { "id": "file.save_all", "command": "project.save" },
        { "id": "file.close_project", "command": "project.close" },
        "separator",
        { "id": "file.preferences", "command": "app.dialog.open:preferences" },
        "separator",
        { "id": "file.quit", "command": "app.quit" }
      ]
    },
    {
      "id": "edit",
      "title": "menu-edit",
      "items": [
        { "id": "edit.undo", "command": "edit.undo", "params": { "document": "$undo_stack" } },
        { "id": "edit.redo", "command": "edit.redo", "params": { "document": "$undo_stack" } }
      ]
    },
    {
      "id": "view",
      "title": "menu-view",
      "items": [
        { "id": "view.zoom_fit", "command": "view.zoom_fit", "params": { "document": "$active_document" } },
        "separator",
        {
          "id": "view.theme",
          "title": "menu-view-theme",
          "items": [
            { "id": "view.theme.follow_os", "command": "view.theme.set:follow_os" },
            { "id": "view.theme.dark", "command": "view.theme.set:dark" },
            { "id": "view.theme.light", "command": "view.theme.set:light" }
          ]
        },
        {
          "id": "view.ui_scale",
          "title": "menu-view-ui-scale",
          "items": [
            { "id": "view.ui_scale.seventy_five", "command": "view.ui_scale.set:75" },
            { "id": "view.ui_scale.eighty_five", "command": "view.ui_scale.set:85" },
            { "id": "view.ui_scale.hundred", "command": "view.ui_scale.set:100" },
            { "id": "view.ui_scale.hundred_fifteen", "command": "view.ui_scale.set:115" },
            { "id": "view.ui_scale.hundred_twenty_five", "command": "view.ui_scale.set:125" },
            { "id": "view.ui_scale.hundred_fifty", "command": "view.ui_scale.set:150" },
            { "id": "view.ui_scale.two_hundred", "command": "view.ui_scale.set:200" },
            "separator",
            { "id": "view.ui_scale.up", "command": "view.ui_scale.step:up" },
            { "id": "view.ui_scale.down", "command": "view.ui_scale.step:down" }
          ]
        }
      ]
    },
    {
      "id": "project",
      "title": "menu-project",
      "items": [
        { "id": "project.settings", "command": "app.settings.open:project_settings" },
        { "id": "project.board_setup", "command": "app.settings.open:board_setup" },
        "separator",
        { "id": "project.sync", "command": "app.dialog.open:change_list" },
        { "id": "project.save", "command": "project.save" }
      ]
    },
    {
      "id": "tools",
      "title": "menu-tools",
      "items": [
        { "id": "tools.keyboard_shortcuts", "command": "app.dialog.open:keyboard_shortcuts" }
      ]
    },
    {
      "id": "window",
      "title": "menu-window",
      "items": [
        { "id": "window.panel.projects", "command": "panel.show:projects" },
        { "id": "window.panel.properties", "command": "panel.show:properties" },
        { "id": "window.panel.messages", "command": "panel.show:messages" },
        { "id": "window.panel.library", "command": "panel.show:library" },
        { "id": "window.panel.layers", "command": "panel.show:layers" },
        { "id": "window.panel.journal", "command": "panel.show:journal" },
        { "id": "window.panel.navigator", "command": "panel.show:navigator" },
        { "id": "window.panel.find", "command": "panel.show:find" },
        "separator",
        { "id": "window.collapse.left", "command": "layout.dock.collapse:left" },
        { "id": "window.collapse.right", "command": "layout.dock.collapse:right" },
        { "id": "window.collapse.bottom", "command": "layout.dock.collapse:bottom" }
      ]
    },
    {
      "id": "help",
      "title": "menu-help",
      "items": [
        { "id": "help.check_updates", "command": "app.update.check" },
        { "id": "help.cli_install", "command": "app.cli.install" },
        "separator",
        { "id": "help.about", "command": "app.dialog.open:about" }
      ]
    }
  ],
  "toolbar": [
    { "id": "toolbar.save", "command": "project.save", "params": { "document": "$active_document" }, "title": "toolbar-save", "icon": "save" },
    { "id": "toolbar.save_all", "command": "project.save" },
    { "id": "toolbar.undo", "command": "edit.undo", "params": { "document": "$undo_stack" } },
    { "id": "toolbar.redo", "command": "edit.redo", "params": { "document": "$undo_stack" } }
  ]
}
