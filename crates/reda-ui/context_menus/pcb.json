        { "id": "context.waive", "command": "drc.waive", "params": { "violations": ["$violation"] }, "title": "context-waive" },
        {
          "id": "context.set_severity",
          "title": "context-set-severity",
          "items": [
            { "id": "context.severity.error", "command": "drc.set_severity", "params": { "check": "$check", "severity": "error" }, "title": "severity-error" },
            { "id": "context.severity.warning", "command": "drc.set_severity", "params": { "check": "$check", "severity": "warning" }, "title": "severity-warning" },
            { "id": "context.severity.off", "command": "drc.set_severity", "params": { "check": "$check", "severity": "off" }, "title": "severity-off" }
          ]
        }
      ]
    },
    {
