{
  "format": 2,
  "uuid": "3d513563-914e-4251-97d8-d3f9836240ad",
  "name": "M.2 card",
  "description": "An M.2 card, 22 mm wide, in the 2230 to 22110 lengths and with the key you pick. The fingers are on the bottom edge (Y = 0), pin 1 toward +X, odd pins on the top side. The far end carries a castellated half-moon for the M2 screw: the outline stays straight and the fab drills the plated hole, then routes through it. Give its Pad a Net, usually GND. The card is 0.8 mm thick, so pick a Fab Preset for 0.8 mm boards: the template does not set the thickness. The fingers are 0.15 mm apart, so pick a Fab Preset with a clearance of 0.15 mm or less (JLCPCB's is 0.10 mm); under a wider clearance, DRC flags the gaps between fingers. No bevel figure is published for M.2 fingers, so none is set; hard gold on the fingers is recommended for a card that is inserted often. The numbers follow the SATA-IO M.2 figures and open M.2 card designs.",
  "category": "PC expansion",
  "suggested_layers": 2,
  "parameters": [
    {"kind":"choice","name":"length","label":"Length","default":"2280","options":[{"key":"2230","label":"2230 (22 x 30 mm)","bind":{"card_length":"30"}},{"key":"2242","label":"2242 (22 x 42 mm)","bind":{"card_length":"42"}},{"key":"2260","label":"2260 (22 x 60 mm)","bind":{"card_length":"60"}},{"key":"2280","label":"2280 (22 x 80 mm)","bind":{"card_length":"80"}},{"key":"22110","label":"22110 (22 x 110 mm)","bind":{"card_length":"110"}}]},
    {"kind":"choice","name":"key","label":"Key","default":"m","options":[{"key":"a","label":"A","bind":{}},{"key":"b","label":"B","bind":{}},{"key":"e","label":"E","bind":{}},{"key":"m","label":"M","bind":{}},{"key":"ae","label":"A+E","bind":{}},{"key":"bm","label":"B+M","bind":{}}]}
