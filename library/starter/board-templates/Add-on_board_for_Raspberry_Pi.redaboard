    {"kind":"choice","name":"size","label":"Size","default":"full","options":[{"key":"full","label":"Full (65 x 56)","bind":{"base_height":"56","top_hole_y":"52.5"}},{"key":"micro","label":"Micro (65 x 30)","bind":{"base_height":"30","top_hole_y":"26.5"}}]},
